<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PrayerApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PrayerApp.Views"
    Title="Ezan Vakti"
    Shell.NavBarHasShadow="False"
    Shell.TabBarIsVisible="True">

    <TabBar Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource BackgroundMid}}"
            Shell.TabBarTitleColor="{StaticResource AccentGold}"
            Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource TextSecondaryDark}}"
            Shell.TabBarForegroundColor="{StaticResource AccentGold}">

        <ShellContent
            Title="Vakitler"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Kıble"
            Icon="tab_qibla.png"
            ContentTemplate="{DataTemplate views:QiblaPage}"
            Route="QiblaPage" />

        <ShellContent
            Title="Ayarlar"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
