<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PrayerApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PrayerApp.Views"
    Title="Ezan Vakti"
    Shell.NavBarHasShadow="False"
    Shell.TabBarIsVisible="True">

    <!-- Onboarding lives in its own TabBar so the main tab bar stays hidden during first run. -->
    <TabBar x:Name="OnboardingBar" Route="Onboarding">
        <ShellContent
            Title="Hoş Geldiniz"
            ContentTemplate="{DataTemplate views:OnboardingPage}"
            Route="OnboardingPage" />
    </TabBar>

    <TabBar x:Name="MainTabBar"
            Route="Main"
            Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource BackgroundElevated}}"
            Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentGold}}"
            Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
            Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentGold}}">

        <ShellContent
            Title="Bugün"
            Icon="tab_home.png"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Kur'an"
            Icon="tab_quran.png"
            ContentTemplate="{DataTemplate views:QuranPage}"
            Route="QuranPage" />

        <ShellContent
            Title="İbadet"
            Icon="tab_worship.png"
            ContentTemplate="{DataTemplate views:WorshipPage}"
            Route="WorshipPage" />

        <ShellContent
            Title="Takvim"
            Icon="tab_calendar.png"
            ContentTemplate="{DataTemplate views:CalendarPage}"
            Route="CalendarPage" />

        <ShellContent
            Title="Keşfet"
            Icon="tab_explore.png"
            ContentTemplate="{DataTemplate views:ExplorePage}"
            Route="ExplorePage" />
    </TabBar>

</Shell>
