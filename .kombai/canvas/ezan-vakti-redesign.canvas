      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Literata:wght@400;600&family=Atkinson+Hyperlegible:wght@400;700&family=Amiri:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/light/style.css\");\n.ft{font-family:'Literata',serif}\n.fn{font-family:'Literata',serif;font-variant-numeric:tabular-nums}\n.fu{font-family:'Atkinson Hyperlegible',sans-serif}\n.fa{font-family:'Amiri',serif}\n</style>\n<div class=\"min-h-screen bg-[#E2E2DD] px-6 py-7\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"mx-auto flex w-full max-w-[1232px] items-start justify-center gap-6\" data-kid=\"1-1\" data-name=\"phones row container\">\n<!-- ================= KUR'AN ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-1\" data-name=\"Kur'an phone mockup container\">\n<p class=\"ft mb-2 pl-1 text-[12px] text-[#5C6467]\" data-kid=\"1-1-1-1\" data-name=\"Kur'an phone label text\">Kur'an</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[10px] bg-[#F4F4F0] shadow-[0_18px_44px_-30px_rgba(34,40,42,0.55)] ring-1 ring-[#C9C7BF]\" data-kid=\"1-1-1-2\" data-name=\"Kur'an phone frame\">\n<div class=\"flex h-11 shrink-0 items-center justify-between px-5\" data-kid=\"1-1-1-2-1\" data-name=\"phone status bar\">\n<span class=\"fu text-[12px] font-bold text-[#22282A]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status bar time text\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#22282A]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status bar indicators container\">\n<i class=\"ph-light ph-wifi-high\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"wifi signal icon\"></i><i class=\"ph-light ph-battery-full\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"battery icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col gap-2.5 overflow-hidden px-4 pt-1\" data-kid=\"1-1-1-2-2\" data-name=\"Kur'an main content area\">\n<div class=\"shrink-0\" data-kid=\"1-1-