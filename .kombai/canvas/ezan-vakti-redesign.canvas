      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bree+Serif&family=Nunito+Sans:wght@400;600;700&family=Amiri:wght@400;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css');\n</style>\n<div class=\"min-h-screen bg-[#E4E9E5] px-6 py-7\" data-kid=\"1\" data-name=\"page background container\" style=\"font-family:'Nunito Sans',-apple-system,sans-serif\">\n<div class=\"mx-auto flex w-full max-w-[1232px] items-start justify-center gap-6\" data-kid=\"1-1\" data-name=\"three phone mockup layout row\">\n<!-- ================= KUR'AN ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-1\" data-name=\"Kur'an phone mockup wrapper\">\n<p class=\"mb-2 pl-1 text-[12px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-1-1\" data-name=\"Kur'an screen tab label\">Kur'an</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[32px] bg-[#EDEFEC] shadow-[0_20px_40px_-30px_rgba(11,20,17,0.45)]\" data-kid=\"1-1-1-2\" data-name=\"Kur'an phone screen card\">\n<div class=\"flex h-11 shrink-0 items-center justify-between px-6\" data-kid=\"1-1-1-2-1\" data-name=\"mobile status bar\">\n<span class=\"text-[12px] font-bold text-[#26332D]\" data-kid=\"1-1-1-2-1-1\" data-name=\"device clock time\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#26332D]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status bar system icons\">\n<i class=\"ri-wifi-line\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"wifi signal icon\"></i><i class=\"ri-battery-line\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col gap-4 overflow-hidden px-4 pt-2\" data-kid=\"1-1-1-2-2\" data-name=\"Kur'an screen main content\">\n<div class=\"shrink-0\" data-kid=\"1-1-1-2-2-1\" data-name=\"Kur'an header section\">\n<h1 class=\"text-[25px] leading-8 text-[#26332D]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"Kur'an main title\" style=\"font-family:'Bree Serif',serif\">Kur'an-ı Kerim</h1>\n<p class=\"mt-1 text-[12.5px] leading-4 text-[#5E6E66]\" data-kid=\"1-1-1-2-2-1-2\" data-name=\"Kur'an subtitle description\">Çevrimdışı Arapça metin ve Diyanet meali</p>\n</div>\n<div class=\"shrink-0 rounded-[24px] bg-white p-4 shadow-[0_12px_26px_-20px_rgba(11,20,17,0.5)]\" data-kid=\"1-1-1-2-2-2\" data-name=\"continue reading card\">\n<p class=\"text-[10px] font-bold uppercase tracking-[0.14em] text-[#8A6A12]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"continue reading card label\">Kaldığın yer</p>\n<p class=\"mt-2 text-[21px] leading-6 text-[#26332D]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"resumed surah name\" style=\"font-family:'Bree Serif',serif\">Bakara Suresi</p>\n<p class=\"mt-1 text-[13px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-2-3\" data-name=\"resumed verse number\">45. ayet</p>\n<div class=\"mt-4 flex h-12 items-center justify-center gap-2 rounded-full bg-[#059669] text-[14px] font-bold text-white\" data-kid=\"1-1-1-2-2-2-4\" data-name=\"continue reading button\">\n              Okumaya devam et<i class=\"ri-arrow-right-line text-[16px]\" data-kid=\"1-1-1-2-2-2-4-1\" data-name=\"right arrow icon\"></i>\n</div>\n</div>\n<div class=\"flex h-11 shrink-0 items-center gap-3 rounded-full bg-[#E3E8E4] px-4\" data-kid=\"1-1-1-2-2-3\" data-name=\"Hatim progress card\">\n<i class=\"ri-book-2-line text-[16px] text-[#059669]\" data-kid=\"1-1-1-2-2-3-1\" data-name=\"book icon\"></i>\n<span class=\"text-[12.5px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-3-2\" data-name=\"Hatim card title label\">Hatim</span>\n<span class=\"text-[12.5px] font-bold tabular-nums text-[#26332D]\" data-kid=\"1-1-1-2-2-3-3\" data-name=\"Hatim progress fraction\">214/604</span>\n<div class=\"ml-auto h-[3px] w-14 rounded-full bg-[#DCE5DF]\" data-kid=\"1-1-1-2-2-3-4\" data-name=\"progress track background\">\n<div class=\"h-full w-[35%] rounded-full bg-[#10B981]\" data-kid=\"1-1-1-2-2-3-4-1\" data-name=\"progress bar fill\"></div>\n</div>\n<i class=\"ri-arrow-right-s-line text-[14px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-3-5\" data-name=\"chevron arrow icon\"></i>\n</div>\n<div class=\"flex shrink-0 flex-col gap-2\" data-kid=\"1-1-1-2-2-4\" data-name=\"tab and search section\">\n<div class=\"grid shrink-0 grid-cols-4 gap-1 rounded-full bg-[#E3E8E4] p-1\" data-kid=\"1-1-1-2-2-4-1\" data-name=\"surah category segmented control\">\n<span class=\"flex h-11 items-center justify-center rounded-full bg-[#10B981] text-[12px] font-bold text-[#0B1411]\" data-kid=\"1-1-1-2-2-4-1-1\" data-name=\"Sureler tab selected\">Sureler</span>\n<span class=\"flex h-11 items-center justify-center rounded-full text-[12px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-1-2-2-4-1-2\" data-name=\"Cüzler tab\">Cüzler</span>\n<span class=\"flex h-11 items-center justify-center rounded-full text-[12px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-1-2-2-4-1-3\" data-name=\"Konular tab\">Konular</span>\n<span class=\"flex h-11 items-center justify-center rounded-full text-[12px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-1-2-2-4-1-4\" data-name=\"Favoriler tab\">Favoriler</span>\n</div>\n<div class=\"flex h-12 items-center gap-2 rounded-[16px] bg-[#F7F8F6] px-3.5\" data-kid=\"1-1-1-2-2-4-2\" data-name=\"search input field\">\n<i class=\"ri-search-line text-[16px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-4-2-1\" data-name=\"search magnifying glass icon\"></i>\n<span class=\"text-[13px] text-[#8C9A93]\" data-kid=\"1-1-1-2-2-4-2-2\" data-name=\"search placeholder text\">Sure adı veya numarası ara</span>\n</div>\n<div class=\"flex h-11 items-center justify-between\" data-kid=\"1-1-1-2-2-4-3\" data-name=\"sort order row\">\n<span class=\"text-[12.5px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-4-3-1\" data-name=\"sort label\">Sıra</span>\n<div class=\"flex items-center gap-2\" data-kid=\"1-1-1-2-2-4-3-2\" data-name=\"sort option group\">\n<span class=\"rounded-full bg-white px-3 py-1.5 text-[12px] font-bold text-[#26332D] shadow-[0_4px_10px_-8px_rgba(11,20,17,0.5)]\" data-kid=\"1-1-1-2-2-4-3-2-1\" data-name=\"Mushaf sort option selected\">Mushaf</span>\n<span class=\"px-2 py-1.5 text-[12px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-1-2-2-4-3-2-2\" data-name=\"Nüzul sort option\">Nüzul</span>\n</div>\n</div>\n</div>\n<div class=\"h-[204px] shrink-0 overflow-hidden rounded-[24px] bg-white shadow-[0_12px_26px_-20px_rgba(11,20,17,0.5)]\" data-kid=\"1-1-1-2-2-5\" data-name=\"surah list container\">\n<div class=\"flex h-[68px] items-center gap-3.5 px-5\" data-kid=\"1-1-1-2-2-5-1\" data-name=\"surah list row 1\">\n<span class=\"w-5 shrink-0 text-right text-[12px] font-bold tabular-nums text-[#8C9A93]\" data-kid=\"1-1-1-2-2-5-1-1\" data-name=\"surah index number false\">1</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-1-2\" data-name=\"surah name details wrapper\">\n<p class=\"truncate text-[15.5px] leading-5 text-[#26332D]\" data-kid=\"1-1-1-2-2-5-1-2-1\" data-name=\"Fâtiha surah name\" style=\"font-family:'Bree Serif',serif\">Fâtiha</p>\n<p class=\"mt-1 flex items-center gap-2 text-[11.5px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-5-1-2-2\" data-name=\"surah detail meta row\">\n<span class=\"whitespace-nowrap text-[16px] leading-[20px] text-[#41544B]\" data-kid=\"1-1-1-2-2-5-1-2-2-1\" data-name=\"Arabic surah name\" style=\"font-family:'Amiri',serif\">الفاتحة</span>\n<span data-kid=\"1-1-1-2-2-5-1-2-2-2\" data-name=\"revelation order tag\">Nüzul 5</span>\n</p>\n</div>\n<span class=\"shrink-0 text-[12.5px] font-semibold tabular-nums text-[#5E6E66]\" data-kid=\"1-1-1-2-2-5-1-3\" data-name=\"verse count\">7 ayet</span>\n</div>\n<div class=\"flex h-[68px] items-center gap-3.5 px-5\" data-kid=\"1-1-1-2-2-5-2\" data-name=\"surah list row 2\">\n<span class=\"w-5 shrink-0 text-right text-[12px] font-bold tabular-nums text-[#8C9A93]\" data-kid=\"1-1-1-2-2-5-2-1\" data-name=\"surah index number 2\">2</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-2-2\" data-name=\"surah name details wrapper\">\n<p class=\"truncate text-[15.5px] leading-5 text-[#26332D]\" data-kid=\"1-1-1-2-2-5-2-2-1\" data-name=\"Bakara surah name\" style=\"font-family:'Bree Serif',serif\">Bakara</p>\n<p class=\"mt-1 flex items-center gap-2 text-[11.5px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-5-2-2-2\" data-name=\"surah detail meta row\">\n<span class=\"whitespace-nowrap text-[16px] leading-[20px] text-[#41544B]\" data-kid=\"1-1-1-2-2-5-2-2-2-1\" data-name=\"Arabic surah name\" style=\"font-family:'Amiri',serif\">البقرة</span>\n<span data-kid=\"1-1-1-2-2-5-2-2-2-2\" data-name=\"revelation order tag\">Nüzul 87</span>\n</p>\n</div>\n<span class=\"shrink-0 text-[12.5px] font-semibold tabular-nums text-[#5E6E66]\" data-kid=\"1-1-1-2-2-5-2-3\" data-name=\"verse count\">286 ayet</span>\n</div>\n<div class=\"flex h-[68px] items-center gap-3.5 px-5\" data-kid=\"1-1-1-2-2-5-3\" data-name=\"surah list row 3\">\n<span class=\"w-5 shrink-0 text-right text-[12px] font-bold tabular-nums text-[#8C9A93]\" data-kid=\"1-1-1-2-2-5-3-1\" data-name=\"surah index number 3\">3</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-3-2\" data-name=\"surah name details wrapper\">\n<p class=\"truncate text-[15.5px] leading-5 text-[#26332D]\" data-kid=\"1-1-1-2-2-5-3-2-1\" data-name=\"Âl-i İmrân surah name\" style=\"font-family:'Bree Serif',serif\">Âl-i İmrân</p>\n<p class=\"mt-1 flex items-center gap-2 text-[11.5px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-5-3-2-2\" data-name=\"surah detail meta row\">\n<span class=\"whitespace-nowrap text-[16px] leading-[20px] text-[#41544B]\" data-kid=\"1-1-1-2-2-5-3-2-2-1\" data-name=\"Arabic surah name\" style=\"font-family:'Amiri',serif\">آل عمران</span>\n<span data-kid=\"1-1-1-2-2-5-3-2-2-2\" data-name=\"revelation order tag\">Nüzul 89</span>\n</p>\n</div>\n<span class=\"shrink-0 text-[12.5px] font-semibold tabular-nums text-[#5E6E66]\" data-kid=\"1-1-1-2-2-5-3-3\" data-name=\"verse count\">200 ayet</span>\n</div>\n</div>\n</div>\n<div class=\"flex h-16 shrink-0 items-stretch bg-white px-1\" data-kid=\"1-1-1-2-3\" data-name=\"Kur'an phone bottom navigation\">\n<div class=\"flex flex-1 flex-col items-center justify-center gap-1 text-[#8C9A93]\" data-kid=\"1-1-1-2-3-1\" data-name=\"Bugün nav item\">\n<i class=\"ri-home-5-line text-[20px]\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"home nav icon\"></i><span class=\"text-[10px] font-semibold leading-3\" data-kid=\"1-1-1-2-3-1-2\" data-name=\"Bugün nav label\">Bugün</span>\n</div>\n<div class=\"flex flex-1 flex-col items-center justify-center gap-1 text-[#059669]\" data-kid=\"1-1-1-2-3-2\" data-name=\"Kur'an nav item selected\">\n<i class=\"ri-book-2-line text-[20px]\" data-kid=\"1-1-1-2-3-2-1\" data-name=\"book nav icon\"></i><span class=\"text-[10px] font-bold leading-3\" data-kid=\"1-1-1-2-3-2-2\" data-name=\"Kur'an nav label\">Kur'an</span>\n</div>\n<div class=\"flex flex-1 flex-col items-center justify-center gap-1 text-[#8C9A93]\" data-kid=\"1-1-1-2-3-3\" data-name=\"İbadet nav item\">\n<i class=\"ri-moon-line text-[20px]\" data-kid=\"1-1-1-2-3-3-1\" data-name=\"moon nav icon\"></i><span class=\"text-[10px] font-semibold leading-3\" data-kid=\"1-1-1-2-3-3-2\" data-name=\"İbadet nav label\">İbadet</span>\n</div>\n<div class=\"flex flex-1 flex-col items-center justify-center gap-1 text-[#8C9A93]\" data-kid=\"1-1-1-2-3-4\" data-name=\"Takvim nav item\">\n<i class=\"ri-calendar-line text-[20px]\" data-kid=\"1-1-1-2-3-4-1\" data-name=\"calendar nav icon\"></i><span class=\"text-[10px] font-semibold leading-3\" data-kid=\"1-1-1-2-3-4-2\" data-name=\"Takvim nav label\">Takvim</span>\n</div>\n<div class=\"flex flex-1 flex-col items-center justify-center gap-1 text-[#8C9A93]\" data-kid=\"1-1-1-2-3-5\" data-name=\"Keşfet nav item\">\n<i class=\"ri-compass-3-line text-[20px]\" data-kid=\"1-1-1-2-3-5-1\" data-name=\"compass nav icon\"></i><span class=\"text-[10px] font-semibold leading-3\" data-kid=\"1-1-1-2-3-5-2\" data-name=\"Keşfet nav label\">Keşfet</span>\n</div>\n</div>\n</div>\n</div>\n<!-- ================= İBADET ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-2\" data-name=\"İbadet phone mockup wrapper\">\n<p class=\"mb-2 pl-1 text-[12px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-2-1\" data-name=\"İbadet screen tab label\">İbadet</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[32px] bg-[#EDEFEC] shadow-[0_20px_40px_-30px_rgba(11,20,17,0.45)]\" data-kid=\"1-1-2-2\" data-name=\"İbadet phone screen card\">\n<div class=\"flex h-11 shrink-0 items-center justify-between px-6\" data-kid=\"1-1-2-2-1\" data-name=\"mobile status bar\">\n<span class=\"text-[12px] font-bold text-[#26332D]\" data-kid=\"1-1-2-2-1-1\" data-name=\"device clock time\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#26332D]\" data-kid=\"1-1-2-2-1-2\" data-name=\"status bar system icons\">\n<i class=\"ri-wifi-line\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"wifi signal icon\"></i><i class=\"ri-battery-line\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col overflow-hidden px-4 pt-2\" data-kid=\"1-1-2-2-2\" data-name=\"İbadet screen main content\">\n<div class=\"flex shrink-0 items-start justify-between\" data-kid=\"1-1-2-2-2-1\" data-name=\"İbadet header row\">\n<div data-kid=\"1-1-2-2-2-1-1\" data-name=\"İbadet title block\">\n<h1 class=\"text-[25px] leading-8 text-[#26332D]\" data-kid=\"1-1-2-2-2-1-1-1\" data-name=\"İbadet main title\" style=\"font-family:'Bree Serif',serif\">İbadet</h1>\n<p class=\"mt-1 text-[12.5px] leading-4 text-[#5E6E66]\" data-kid=\"1-1-2-2-2-1-1-2\" data-name=\"İbadet subtitle\">Zikirmatik, namaz ve kaza takibi</p>\n</div>\n<div class=\"mt-1 text-right\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"prayer today summary block\">\n<p class=\"text-[10.5px] text-[#8C9A93]\" data-kid=\"1-1-2-2-2-1-2-1\" data-name=\"today label\">Bugün</p>\n<p class=\"text-[13px] font-bold tabular-nums text-[#059669]\" data-kid=\"1-1-2-2-2-1-2-2\" data-name=\"prayers completed fraction\">3/5 vakit</p>\n</div>\n</div>\n<div class=\"mt-4 grid shrink-0 grid-cols-3 gap-1 rounded-full bg-[#E3E8E4] p-1\" data-kid=\"1-1-2-2-2-2\" data-name=\"İbadet category segmented control\">\n<span class=\"flex h-11 items-center justify-center rounded-full bg-[#10B981] text-[12px] font-bold text-[#0B1411]\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"Zikirmatik tab selected\">Zikirmatik</span>\n<span class=\"flex h-11 items-center justify-center rounded-full text-[12px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"Namaz &amp; Kaza tab\">Namaz &amp; Kaza</span>\n<span class=\"flex h-11 items-center justify-center rounded-full text-[12px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-2-2-2-2-3\" data-name=\"Hatim Planı tab\">Hatim Planı</span>\n</div>\n<div class=\"mt-3 flex shrink-0 gap-2 overflow-hidden\" data-kid=\"1-1-2-2-2-3\" data-name=\"zikir counter chip row\">\n<span class=\"flex h-11 shrink-0 items-center gap-2 rounded-full bg-white px-4 text-[12.5px] font-bold text-[#059669] shadow-[0_6px_14px_-10px_rgba(11,20,17,0.45)]\" data-kid=\"1-1-2-2-2-3-1\" data-name=\"Sübhanallah active counter chip\">\n              Sübhanallah <span class=\"tabular-nums text-[#8A6A12]\" data-kid=\"1-1-2-2-2-3-1-1\" data-name=\"Sübhanallah count number\">33</span>\n</span>\n<span class=\"flex h-11 shrink-0 items-center gap-2 rounded-full bg-[#E3E8E4] px-4 text-[12.5px] font-semibold text-[#26332D]\" data-kid=\"1-1-2-2-2-3-2\" data-name=\"Elhamdülillah counter chip\">\n              Elhamdülillah <span class=\"tabular-nums text-[#8A6A12]\" data-kid=\"1-1-2-2-2-3-2-1\" data-name=\"Elhamdülillah count number\">33</span>\n</span>\n</div>\n<div class=\"mt-2 flex h-11 shrink-0 items-center justify-center gap-2 rounded-full bg-[#E3E8E4] text-[12.5px] font-bold text-[#059669]\" data-kid=\"1-1-2-2-2-4\" data-name=\"namaz tesbihat indicator\">\n<i class=\"ri-list-check text-[16px]\" data-kid=\"1-1-2-2-2-4-1\" data-name=\"checklist icon\"></i>Namaz tesbihatı (33 × 3)\n          </div>\n<div class=\"mt-4 flex shrink-0 items-center justify-center\" data-kid=\"1-1-2-2-2-5\" data-name=\"zikirmatik circular dial wrapper\">\n<div class=\"relative flex h-[258px] w-[258px] items-center justify-center rounded-full\" data-kid=\"1-1-2-2-2-5-1\" data-name=\"progress ring and dial\" style=\"background:conic-gradient(from -90deg, #10B981 0deg 230deg, #CFDAD3 230deg 360deg)\">\n<div class=\"relative flex h-[240px] w-[240px] flex-col items-center justify-center rounded-full bg-[#059669] shadow-[0_8px_18px_-12px_rgba(11,20,17,0.35)]\" data-kid=\"1-1-2-2-2-5-1-1\" data-name=\"zikirmatik dial face\" style=\"box-shadow:0 8px 18px -12px rgba(11,20,17,0.35)\">\n<div class=\"pointer-events-none absolute inset-[6px] rounded-full border border-[#D4AF37]\" data-kid=\"1-1-2-2-2-5-1-1-1\" data-name=\"inner gold decorative ring\"></div>\n<p class=\"text-[17px] text-[#E5C76B]\" data-kid=\"1-1-2-2-2-5-1-1-2\" data-name=\"dial dhikr name\" style=\"font-family:'Bree Serif',serif\">Sübhanallah</p>\n<p class=\"mt-1 text-[64px] leading-[70px] tabular-nums text-[#E5C76B]\" data-kid=\"1-1-2-2-2-5-1-1-3\" data-name=\"dial current count number\">21</p>\n<p class=\"mt-1 text-[11.5px] font-semibold text-white/85\" data-kid=\"1-1-2-2-2-5-1-1-4\" data-name=\"dial target count text\">Hedef 33</p>\n<p class=\"mt-5 text-[11px] text-white/70\" data-kid=\"1-1-2-2-2-5-1-1-5\" data-name=\"gesture hint text\">Saymak için dokun</p>\n</div>\n</div>\n</div>\n<div class=\"mt-4 flex shrink-0 items-center gap-2\" data-kid=\"1-1-2-2-2-6\" data-name=\"dial control buttons row\">\n<div class=\"flex h-11 flex-1 items-center justify-center gap-1.5 rounded-full bg-[#E3E8E4] text-[13px] font-bold text-[#26332D]\" data-kid=\"1-1-2-2-2-6-1\" data-name=\"decrement by one button\">\n<i class=\"ri-subtract-line text-[14px]\" data-kid=\"1-1-2-2-2-6-1-1\" data-name=\"minus icon\"></i>1 azalt\n            </div>\n<div class=\"flex h-11 flex-1 items-center justify-cen