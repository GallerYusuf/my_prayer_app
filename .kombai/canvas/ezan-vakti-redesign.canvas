      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=Overpass:wght@400;600;700&family=Amiri:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"min-h-screen bg-[#EBEEEC] px-6 py-7\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Overpass',sans-serif\">\n<div class=\"mx-auto flex w-full max-w-[1232px] items-start justify-center gap-6\" data-kid=\"1-1\" data-name=\"three screen prototypes row\">\n<!-- ================= KUR'AN ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-1\" data-name=\"Kur'an screen column wrapper\">\n<p class=\"mb-2 pl-1 text-[12px] font-semibold tracking-[-0.01em] text-[#55605A]\" data-kid=\"1-1-1-1\" data-name=\"Kur'an screen label\" style=\"font-family:'Archivo'\">Kur'an</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[30px] bg-white ring-1 ring-[#DDE3E0]\" data-kid=\"1-1-1-2\" data-name=\"Kur'an screen phone frame\">\n<div class=\"flex h-11 shrink-0 items-center justify-between px-6\" data-kid=\"1-1-1-2-1\" data-name=\"status bar\">\n<span class=\"text-[12px] font-semibold tabular-nums text-[#0B1411]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status bar clock\" style=\"font-family:'Archivo'\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#0B1411]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status bar icons container\">\n<i class=\"ti ti-wifi\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"wifi status icon\"></i><i class=\"ti ti-battery-3\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"battery status icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col overflow-hidden\" data-kid=\"1-1-1-2-2\" data-name=\"screen content scroll area\">\n<div class=\"flex min-h-0 flex-1 flex-col gap-2.5 overflow-hidden px-4 pt-1\" data-kid=\"1-1-1-2-2-1\" data-name=\"Kur'an screen main content\">\n<div class=\"shri