      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Overpass:wght@400;600&family=Amiri:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"min-h-screen bg-[#E4EAE6] px-6 py-7\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Overpass',-apple-system,sans-serif\">\n<div class=\"mx-auto flex w-full max-w-[1232px] items-start justify-center gap-6\" data-kid=\"1-1\" data-name=\"design showcase row containing app screens\">\n<!-- ================= KUR'AN ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-1\" data-name=\"Quran app screen wrapper\">\n<p class=\"mb-2 pl-1 text-[12px] font-semibold text-[#55605A]\" data-kid=\"1-1-1-1\" data-name=\"screen label caption\">Kur'an</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[24px] bg-white ring-1 ring-[#D5DDD8]\" data-kid=\"1-1-1-2\" data-name=\"Quran phone screen frame\">\n<div class=\"flex h-11 shrink-0 items-center justify-between px-6\" data-kid=\"1-1-1-2-1\" data-name=\"status bar\">\n<span class=\"text-[12px] font-bold text-[#0B1411]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status bar clock time\" style=\"font-family:'Archivo',sans-serif\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#0B1411]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status bar system icons container\">\n<i class=\"ti ti-wifi\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"wifi signal icon\"></i><i class=\"ti ti-battery-3\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col gap-4 overflow-hidden px-4 pt-2\" data-kid=\"1-1-1-2-2\" data-name=\"app main scroll content\">\n<div class=\"shrink-0\" data-kid=\"1-1-1-2-2-1\" data-name=\"page title wrapper\">\n<h1 class=\"text-[24px] leading-8 tracking-[-0.02em] text-[#0B1411]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"app headline text\" style=\"font-family:'Archivo',sans-serif;font-weight:700\">Kur'an-ı Kerim</h1>\n<p class=\"mt-1 text-[12.5px] leading-4 text-[#55605A]\" data-kid=\"1-1-1-2-2-1-2\" data-name=\"app tagline description\">Çevrimdışı Arapça metin ve Diyanet meali</p>\n</div>\n<div class=\"shrink-0 rounded-[20px] border border-[#C6D2CC] bg-white p-[18px]\" data-kid=\"1-1-1-2-2-2\" data-name=\"resume reading card\">\n<p class=\"text-[10px] font-bold tracking-[0.14em] text-[#059669]\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"resume card section label\" style=\"font-family:'Overpass',sans-serif\">KALDIĞIN YER</p>\n<p class=\"mt-2 text-[21px] leading-6 tracking-[-0.02em] text-[#0B1411]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"resume chapter name\" style=\"font-family:'Archivo',sans-serif;font-weight:700\">Bakara Suresi</p>\n<p class=\"mt-1 text-[13px] text-[#55605A]\" data-kid=\"1-1-1-2-2-2-3\" data-name=\"resume verse number\">45. ayet</p>\n<div class=\"mt-4 flex h-12 items-center justify-center gap-2 rounded-[2px] bg-[#059669] text-[14px] text-white shadow-[0_2px_0_rgba(11,20,17,0.28)]\" data-kid=\"1-1-1-2-2-2-4\" data-name=\"continue reading call-to-action button\" style=\"font-family:'Archivo',sans-serif;font-weight:700\">\n              Okumaya devam et<i class=\"ti ti-arrow-right text-[16px]\" data-kid=\"1-1-1-2-2-2-4-1\" data-name=\"right arrow icon\"></i>\n</div>\n</div>\n<div class=\"flex h-11 shrink-0 items-center gap-3 rounded-[14px] bg-[#F4F6F5] px-3.5\" data-kid=\"1-1-1-2-2-3\" data-name=\"haymi progress row\">\n<i class=\"ti ti-book-2 text-[16px] text-[#059669]\" data-kid=\"1-1-1-2-2-3-1\" data-name=\"book icon\"></i>\n<span class=\"text-[12.5px] text-[#55605A]\" data-kid=\"1-1-1-2-2-3-2\" data-name=\"haymi feature label\">Hatim</span>\n<span class=\"text-[12.5px] tabular-nums text-[#0B1411]\" data-kid=\"1-1-1-2-2-3-3\" data-name=\"haymi progress count\" style=\"font-family:'Archivo',sans-serif;font-weight:700\">214/604</span>\n<div class