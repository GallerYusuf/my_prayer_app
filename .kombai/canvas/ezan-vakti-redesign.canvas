      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bree+Serif&family=Nunito+Sans:wght@400;600;700&family=Amiri:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css\");\n.ft{font-family:'Bree Serif',serif}\n.fu{font-family:'Nunito Sans',sans-serif}\n.fn{font-family:'Nunito Sans',sans-serif;font-variant-numeric:tabular-nums}\n.fa{font-family:'Amiri',serif}\n</style>\n<div class=\"min-h-screen bg-[#E4E8E5] px-6 py-7\" data-kid=\"1\" data-name=\"page layout container with green-gray background\">\n<div class=\"mx-auto flex w-full max-w-[1232px] items-start justify-center gap-6\" data-kid=\"1-1\" data-name=\"three phone screen layout row\">\n<!-- ================= KUR'AN ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-1\" data-name=\"Kur'an mobile phone screen mockup\">\n<p class=\"fu mb-2 pl-1 text-[12px] font-bold text-[#5E6E66]\" data-kid=\"1-1-1-1\" data-name=\"screen label text Kur'an\">Kur'an</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[34px] bg-[#EDEFEC] shadow-[0_26px_50px_-32px_rgba(11,20,17,0.5)]\" data-kid=\"1-1-1-2\" data-name=\"phone frame with rounded screen\">\n<div class=\"flex h-11 shrink-0 items-center justify-between px-6\" data-kid=\"1-1-1-2-1\" data-name=\"phone status bar\">\n<span class=\"fn text-[12px] font-bold text-[#26332D]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status bar clock time\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#26332D]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status bar connection icons group\">\n<i class=\"ri-wifi-line\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"wifi signal icon\"></i><i class=\"ri-battery-line\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col gap-2.5 overflow-hidden px-4 pt-1\" data-kid=\"1-1-1-2-2\" data-name=\"Kur'an screen main content area\">\n<div class=\"shrink-0\" dat