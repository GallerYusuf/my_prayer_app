      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Amiri:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n</style>\n<div class=\"min-h-screen bg-[#E7ECE7] px-6 py-7\" data-kid=\"1\" data-name=\"app layout container\" style=\"font-family:'Open Sans',-apple-system,sans-serif\">\n<div class=\"mx-auto flex w-full max-w-[1232px] items-start justify-center gap-6\" data-kid=\"1-1\" data-name=\"phone mockup row\">\n<!-- ================= KUR'AN ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-1\" data-name=\"Kur'an phone mockup\">\n<p class=\"mb-2 pl-1 text-[12px] font-semibold text-[#52635B]\" data-kid=\"1-1-1-1\" data-name=\"Kur'an mockup screen label\">Kur'an</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[30px] bg-[#F5F7F5] shadow-[0_24px_50px_-30px_rgba(17,28,24,0.5)] ring-1 ring-[#C7D2CB]\" data-kid=\"1-1-1-2\" data-name=\"Kur'an phone screen frame\">\n<div class=\"flex h-11 shrink-0 items-center justify-between px-6\" data-kid=\"1-1-1-2-1\" data-name=\"phone status bar\">\n<span class=\"text-[12px] font-semibold text-[#111C18]\" data-kid=\"1-1-1-2-1-1\" data-name=\"phone clock time\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#111C18]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status bar icons row\">\n<i class=\"ti ti-wifi\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"wifi icon\"></i><i class=\"ti ti-battery-3\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"battery icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col gap-4 overflow-hidden px-4 pt-2\" data-kid=\"1-1-1-2-2\" data-name=\"Kur'an screen content area\">\n<div class=\"shrink-0\" data-kid=\"1-1-1-2-2-1\" data-name=\"Kur'an screen header wrapper\">\n<h1 class=\"text-[24px] font-semibold leading-8 tracking-[-0.02em] text-[#111C18]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"Kur'an scree