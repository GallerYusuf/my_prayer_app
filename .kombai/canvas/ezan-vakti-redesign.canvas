s panel\">\n<div class=\"flex h-12 items-center gap-3\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"resume reading row\">\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-2-1-1\" data-name=\"resume reading info container\">\n<p class=\"text-[10.5px] leading-4 text-[#5C6467]\" data-kid=\"1-1-1-2-2-2-1-1-1\" data-name=\"resume label text\">Kaldığın yer</p>\n<p class=\"truncate text-[13.5px] font-semibold leading-5 text-[#22282A]\" data-kid=\"1-1-1-2-2-2-1-1-2\" data-name=\"resume verse reference text\" style=\"font-family:'Literata',serif\">Bakara Suresi, 45. ayet</p>\n</div>\n<div class=\"flex h-9 shrink-0 items-center border border-[#059669] px-3 text-[12px] font-bold text-[#059669]\" data-kid=\"1-1-1-2-2-2-1-2\" data-name=\"read button\">Oku</div>\n</div>\n<div class=\"flex h-9 items-center gap-2.5\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"khatm progress row\">\n<span class=\"shrink-0 text-[11.5px] text-[#5C6467]\" data-kid=\"1-1-1-2-2-2-2-1\" data-name=\"khatm label text\">Hatim</span>\n<span class=\"shrink-0 text-[12px] font-semibold tabular-nums text-[#22282A]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-2-2-2\" data-name=\"khatm progress fraction\" data-reason=\"progress fraction rewritten by state script\" style=\"font-family:'Literata',serif\">214/604</span>\n<div class=\"relative h-[1px] min-w-0 flex-1 bg-[#C9C7BF]\" data-kid=\"1-1-1-2-2-2-2-3\" data-name=\"khatm progress track\">\n<div class=\"absolute -top-[1px] left-0 h-[2px] w-[35%] bg-[#10B981]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-2-2-3-1\" data-name=\"khatm progress fill bar\" data-reason=\"width percentage written by script\"></div>\n</div>\n<span class=\"shrink-0 text-[11.5px] font-semibold tabular-nums text-[#5C6467]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-2-2-4\" data-name=\"khatm percent label\" data-reason=\"percent text rewritten by state script\" style=\"font-family:'Literata',serif\">%35</span>\n</div>\n</div>\n</div>\n<div class=\"flex h-16 shrink-0 items-stretch border-t border-[#C