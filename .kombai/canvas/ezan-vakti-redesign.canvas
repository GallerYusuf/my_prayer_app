      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Bree+Serif&family=Nunito+Sans:wght@400;600;700&family=Amiri:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/remixicon@4.9.1/fonts/remixicon.css\");\n</style>\n<div class=\"min-h-screen bg-[#E2E6E2] px-6 py-7\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Nunito Sans',sans-serif\">\n<div class=\"mx-auto flex w-full max-w-[1232px] items-start justify-center gap-6\" data-kid=\"1-1\" data-name=\"app screenshots row\">\n<!-- ================= KUR'AN ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-1\" data-name=\"Kur'an screen mockup\">\n<p class=\"mb-2 pl-1 text-[12px] text-[#5E6E66]\" data-kid=\"1-1-1-1\" data-name=\"Kur'an screen label\" style=\"font-family:'Bree Serif',serif\">Kur'an</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[32px] bg-[#EDEFEC]\" data-kid=\"1-1-1-2\" data-name=\"phone frame for Kur'an screen\">\n<div class=\"flex h-11 shrink-0 items-center justify-between px-6\" data-kid=\"1-1-1-2-1\" data-name=\"phone status bar\">\n<span class=\"text-[12px] font-bold tabular-nums text-[#26332D]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status bar time\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#26332D]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status bar icons container\">\n<i class=\"ri-wifi-line\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"wi-fi status icon\"></i><i class=\"ri-battery-2-line\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"battery status icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col overflow-hidden\" data-kid=\"1-1-1-2-2\" data-name=\"Kur'an screen content area\">\n<div class=\"flex min-h-0 flex-1 flex-col gap-2.5 overflow-hidden px-4 pb-2 pt-1\" data-kid=\"1-1-1-2-2-1\" data-name=\"Kur'an main content column\">\n<div class=\"shrink-0\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"Kur'an header block\">\n<h1 class=\"text-[22px] leading-7 text-[#26332D]\" data-kid=\"1-1-1-2-2-1-1-1\" data-name=\"Kur'an screen title\" style=\"font-family:'Bree Serif',serif\">Kur'an-ı Kerim</h1>\n<p class=\"mt-1 text-[11.5px] leading-4 text-[#5E6E66]\" data-kid=\"1-1-1-2-2-1-1-2\" data-name=\"Kur'an screen subtitle\">Çevrimdışı Arapça metin ve Diyanet meali</p>\n</div>\n<div class=\"grid shrink-0 grid-cols-4 gap-[2px] rounded-full bg-[#E3E8E4] p-[2px]\" data-kid=\"1-1-1-2-2-1-2\" data-name=\"segmented tab switcher\">\n<span class=\"flex h-10 items-center justify-center rounded-full bg-[#10B981] text-[11.5px] font-bold text-[#0B1411]\" data-kid=\"1-1-1-2-2-1-2-1\" data-name=\"active Sureler tab\">Sureler</span>\n<span class=\"flex h-10 items-center justify-center rounded-full text-[11.5px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-1-2-2-1-2-2\" data-name=\"Cüzler tab\">Cüzler</span>\n<span class=\"flex h-10 items-center justify-center rounded-full text-[11.5px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-1-2-2-1-2-3\" data-name=\"Konular tab\">Konular</span>\n<span class=\"flex h-10 items-center justify-center rounded-full text-[11.5px] font-semibold text-[#5E6E66]\" data-kid=\"1-1-1-2-2-1-2-4\" data-name=\"Favoriler tab\">Favoriler</span>\n</div>\n<div class=\"flex h-11 shrink-0 items-center gap-2 rounded-[14px] bg-white px-3\" data-kid=\"1-1-1-2-2-1-3\" data-name=\"sure search bar\">\n<i class=\"ri-search-line text-[15px] text-[#5E6E66]\" data-kid=\"1-1-1-2-2-1-3-1\" data-name=\"search icon\"></i>\n<span class=\"text-[12.5px] text-[#8A968F]\" data-kid=\"1-1-1-2-2-1-3-2\" data-name=\"search placeholder text\">Sure adı veya numarası ara</span>\n</div>\n<div class=\"flex h-9 shrink-0 items-center justify-between\" data-kid=\"1-1-1-2-2-1-4\" data-name=\"sort order row\">\n<span class=\"text-[11.5px] text-[#5E6E66]\" data-dynamic=\"true\" data-kid=\"1-1-1-2-2-1-4-1\" data-name=\"sort label\" data-reason=\"sort order (Mushaf/Taninim) is a state that the page rewrites from selected value\">Sıra: Mushaf</span>\n<s