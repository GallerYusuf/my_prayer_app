      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=Overpass:wght@400;600&family=Amiri:wght@400;700&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n.ft{font-family:'Archivo',sans-serif;letter-spacing:-0.02em}\n.fn{font-family:'Archivo',sans-serif;font-variant-numeric:tabular-nums;letter-spacing:-0.02em}\n.fu{font-family:'Overpass',sans-serif}\n.fa{font-family:'Amiri',serif}\n</style>\n<div class=\"min-h-screen bg-[#E7ECEA] px-6 py-7\" data-kid=\"1\" data-name=\"page layout container\">\n<div class=\"mx-auto flex w-full max-w-[1232px] items-start justify-center gap-6\" data-kid=\"1-1\" data-name=\"three phone mockup columns wrapper\">\n<!-- ================= KUR'AN ================= -->\n<div class=\"w-[375px] shrink-0\" data-kid=\"1-1-1\" data-name=\"Kur'an phone screen column\">\n<p class=\"ft mb-2 pl-1 text-[12px] font-semibold text-[#55605A]\" data-kid=\"1-1-1-1\" data-name=\"Kur'an screen label caption\">Kur'an</p>\n<div class=\"flex h-[812px] w-[375px] flex-col overflow-hidden rounded-[18px] bg-white shadow-[0_20px_44px_-32px_rgba(11,20,17,0.5)] ring-1 ring-[#DDE3E0]\" data-kid=\"1-1-1-2\" data-name=\"Kur'an phone frame card\">\n<div class=\"flex h-11 shrink-0 items-center justify-between border-b-2 border-[#F1F4F3] px-5\" data-kid=\"1-1-1-2-1\" data-name=\"status bar\">\n<span class=\"fn text-[12px] font-semibold text-[#0B1411]\" data-kid=\"1-1-1-2-1-1\" data-name=\"status bar clock time\">16:10</span>\n<div class=\"flex items-center gap-1.5 text-[13px] text-[#0B1411]\" data-kid=\"1-1-1-2-1-2\" data-name=\"status bar connectivity icons\">\n<i class=\"ti ti-wifi\" data-kid=\"1-1-1-2-1-2-1\" data-name=\"wifi signal icon\"></i><i class=\"ti ti-battery-3\" data-kid=\"1-1-1-2-1-2-2\" data-name=\"battery level icon\"></i>\n</div>\n</div>\n<div class=\"flex min-h-0 flex-1 flex-col gap-2 overflow-hidden px-4 pt-2\" data-kid=\"1-1-1-2-2\" data-name=\"Kur'an screen main content\">\n<div class=\"shrink-0\" data-kid=\"1-1-1-2-2-1\" data-name=\"header block wrapper\">\n<h1 class=\"ft text-[24px] font-bold leading-7 text-[#0B1411]\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"screen title heading\">Kur'an-ı Kerim</h1>\n<p class=\"fu mt-1 text-[12px] leading-4 text-[#55605A]\" data-kid=\"1-1-1-2-2-1-2\" data-name=\"screen description subtitle\">Çevrimdışı Arapça metin ve Diyanet meali</p>\n</div>\n<div class=\"shrink-0 overflow-hidden rounded-[20px] border border-[#DDE3E0] bg-white\" data-kid=\"1-1-1-2-2-2\" data-name=\"continue reading card\">\n<div class=\"flex h-[52px] items-center gap-3 px-3.5\" data-kid=\"1-1-1-2-2-2-1\" data-name=\"continue reading row\">\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-2-1-1\" data-name=\"continue reading text group\">\n<p class=\"ft text-[10px] font-bold tracking-[0.14em] text-[#55605A]\" data-kid=\"1-1-1-2-2-2-1-1-1\" data-name=\"continue reading label caption\">KALDIĞIN YER</p>\n<p class=\"ft mt-1 truncate text-[14px] font-semibold text-[#0B1411]\" data-kid=\"1-1-1-2-2-2-1-1-2\" data-name=\"continue reading chapter title\">Bakara Suresi, 45. ayet</p>\n</div>\n<span class=\"ft flex h-9 items-center rounded-[2px] bg-[#059669] px-4 text-[11.5px] font-bold tracking-[0.04em] text-white shadow-[0_2px_0_rgba(11,20,17,0.28)]\" data-kid=\"1-1-1-2-2-2-1-2\" data-name=\"read action button\">Oku</span>\n</div>\n<div class=\"h-[2px] bg-[#DDE3E0]\" data-kid=\"1-1-1-2-2-2-2\" data-name=\"card divider line\"></div>\n<div class=\"flex h-[44px] items-center gap-2.5 px-3.5\" data-kid=\"1-1-1-2-2-2-3\" data-name=\"hatem progress row\">\n<i class=\"ti ti-book-2 text-[15px] text-[#059669]\" data-kid=\"1-1-1-2-2-2-3-1\" data-name=\"open book icon\"></i>\n<span class=\"fu text-[12px] text-[#55605A]\" data-kid=\"1-1-1-2-2-2-3-2\" data-name=\"hatem label text\">Hatim</span>\n<span class=\"fn text-[13px] font-semibold text-[#0B1411]\" data-kid=\"1-1-1-2-2-2-3-3\" data-name=\"hatem progress fraction\">214/604</span>\n<div class=\"ml-auto h-[4px] w-[54px] bg-[#EDF1EF]\" data-kid=\"1-1-1-2-2-2-3-4\" data-name=\"hatem progress track\">\n<div class=\"h-full w-[35%] bg-[#10B981]\" data-kid=\"1-1-1-2-2-2-3-4-1\" data-name=\"hatem progress fill\"></div>\n</div>\n<i class=\"ti ti-chevron-right text-[13px] text-[#55605A]\" data-kid=\"1-1-1-2-2-2-3-5\" data-name=\"chevron right icon\"></i>\n</div>\n</div>\n<div class=\"grid shrink-0 grid-cols-4 gap-1 overflow-hidden rounded-full border border-[#DDE3E0] bg-[#F1F4F3] p-1 shadow-[inset_0_-2px_4px_rgba(11,20,17,0.07)]\" data-kid=\"1-1-1-2-2-3\" data-name=\"Kur'an segmented tab bar\">\n<span class=\"ft flex h-8 items-center justify-center rounded-full bg-[#059669] text-[11px] font-bold text-white\" data-kid=\"1-1-1-2-2-3-1\" data-name=\"active Sureler tab\">Sureler</span>\n<span class=\"fu flex h-8 items-center justify-center text-[11.5px] text-[#55605A]\" data-kid=\"1-1-1-2-2-3-2\" data-name=\"Cüzler tab\">Cüzler</span>\n<span class=\"fu flex h-8 items-center justify-center text-[11.5px] text-[#55605A]\" data-kid=\"1-1-1-2-2-3-3\" data-name=\"Konular tab\">Konular</span>\n<span class=\"fu flex h-8 items-center justify-center text-[11.5px] text-[#55605A]\" data-kid=\"1-1-1-2-2-3-4\" data-name=\"Favoriler tab\">Favoriler</span>\n</div>\n<div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-2-2-4\" data-name=\"search and sort row\">\n<div class=\"flex h-11 flex-1 items-center gap-2 rounded-[14px] border border-[#DDE3E0] bg-[#F4F6F5] px-3\" data-kid=\"1-1-1-2-2-4-1\" data-name=\"search input field\">\n<i class=\"ti ti-search text-[15px] text-[#55605A]\" data-kid=\"1-1-1-2-2-4-1-1\" data-name=\"search magnifier icon\"></i>\n<span class=\"fu text-[13px] text-[#7C8881]\" data-kid=\"1-1-1-2-2-4-1-2\" data-name=\"search placeholder text\">Sure adı veya numarası ara</span>\n</div>\n<div class=\"ft flex h-11 items-center gap-1.5 rounded-full border border-[#DDE3E0] bg-white px-3 text-[11px] font-semibold text-[#0B1411]\" data-kid=\"1-1-1-2-2-4-2\" data-name=\"sort selector button\">\n<i class=\"ti ti-arrows-sort text-[12px]\" data-kid=\"1-1-1-2-2-4-2-1\" data-name=\"sort arrows icon\"></i>Mushaf\n            </div>\n</div>\n<div class=\"min-h-0 flex-1 overflow-hidden rounded-[20px] border border-[#DDE3E0] bg-white\" data-kid=\"1-1-1-2-2-5\" data-name=\"surah list panel\">\n<div class=\"flex h-[61px] items-center gap-3 border-b-2 border-[#DDE3E0] px-3.5\" data-kid=\"1-1-1-2-2-5-1\" data-name=\"surah row for Fâtiha\">\n<span class=\"fn w-5 shrink-0 text-[12px] font-semibold text-[#7C8881]\" data-kid=\"1-1-1-2-2-5-1-1\" data-name=\"surah number badge\">1</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-1-2\" data-name=\"surah title group\">\n<p class=\"ft truncate text-[14.5px] font-semibold leading-5 text-[#0B1411]\" data-kid=\"1-1-1-2-2-5-1-2-1\" data-name=\"surah name title\">Fâtiha</p>\n<p class=\"fu mt-0.5 flex items-center gap-2 text-[11px] text-[#55605A]\" data-kid=\"1-1-1-2-2-5-1-2-2\" data-name=\"surah Arabic name and order row\">\n<span class=\"fa whitespace-nowrap text-[15px] leading-[19px] text-[#26332D]\" data-kid=\"1-1-1-2-2-5-1-2-2-1\" data-name=\"Arabic surah name\">الفاتحة</span>\n<span data-kid=\"1-1-1-2-2-5-1-2-2-2\" data-name=\"recitation order text\">Nüzul 5</span>\n</p>\n</div>\n<span class=\"fn shrink-0 text-[12px] font-semibold text-[#55605A]\" data-kid=\"1-1-1-2-2-5-1-3\" data-name=\"surah verse count\">7 ayet</span>\n</div>\n<div class=\"flex h-[61px] items-center gap-3 border-b-2 border-[#DDE3E0] px-3.5\" data-kid=\"1-1-1-2-2-5-2\" data-name=\"surah row for Bakara\">\n<span class=\"fn w-5 shrink-0 text-[12px] font-semibold text-[#7C8881]\" data-kid=\"1-1-1-2-2-5-2-1\" data-name=\"surah number badge\">2</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-2-2\" data-name=\"surah title group\">\n<p class=\"ft truncate text-[14.5px] font-semibold leading-5 text-[#0B1411]\" data-kid=\"1-1-1-2-2-5-2-2-1\" data-name=\"surah name title\">Bakara</p>\n<p class=\"fu mt-0.5 flex items-center gap-2 text-[11px] text-[#55605A]\" data-kid=\"1-1-1-2-2-5-2-2-2\" data-name=\"surah Arabic name and order row\">\n<span class=\"fa whitespace-nowrap text-[15px] leading-[19px] text-[#26332D]\" data-kid=\"1-1-1-2-2-5-2-2-2-1\" data-name=\"Arabic surah name\">البقرة</span>\n<span data-kid=\"1-1-1-2-2-5-2-2-2-2\" data-name=\"recitation order text\">Nüzul 87</span>\n</p>\n</div>\n<span class=\"fn shrink-0 text-[12px] font-semibold text-[#55605A]\" data-kid=\"1-1-1-2-2-5-2-3\" data-name=\"surah verse count\">286 ayet</span>\n</div>\n<div class=\"flex h-[61px] items-center gap-3 border-b-2 border-[#DDE3E0] px-3.5\" data-kid=\"1-1-1-2-2-5-3\" data-name=\"surah row for Âl-i İmrân\">\n<span class=\"fn w-5 shrink-0 text-[12px] font-semibold text-[#7C8881]\" data-kid=\"1-1-1-2-2-5-3-1\" data-name=\"surah number badge\">3</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-3-2\" data-name=\"surah title group\">\n<p class=\"ft truncate text-[14.5px] font-semibold leading-5 text-[#0B1411]\" data-kid=\"1-1-1-2-2-5-3-2-1\" data-name=\"surah name title\">Âl-i İmrân</p>\n<p class=\"fu mt-0.5 flex items-center gap-2 text-[11px] text-[#55605A]\" data-kid=\"1-1-1-2-2-5-3-2-2\" data-name=\"surah Arabic name and order row\">\n<span class=\"fa whitespace-nowrap text-[15px] leading-[19px] text-[#26332D]\" data-kid=\"1-1-1-2-2-5-3-2-2-1\" data-name=\"Arabic surah name\">آل عمران</span>\n<span data-kid=\"1-1-1-2-2-5-3-2-2-2\" data-name=\"recitation order text\">Nüzul 89</span>\n</p>\n</div>\n<span class=\"fn shrink-0 text-[12px] font-semibold text-[#55605A]\" data-kid=\"1-1-1-2-2-5-3-3\" data-name=\"surah verse count\">200 ayet</span>\n</div>\n<div class=\"flex h-[61px] items-center gap-3 border-b-2 border-[#DDE3E0] px-3.5\" data-kid=\"1-1-1-2-2-5-4\" data-name=\"surah row for Nisâ\">\n<span class=\"fn w-5 shrink-0 text-[12px] font-semibold text-[#7C8881]\" data-kid=\"1-1-1-2-2-5-4-1\" data-name=\"surah number badge\">4</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-4-2\" data-name=\"surah title group\">\n<p class=\"ft truncate text-[14.5px] font-semibold leading-5 text-[#0B1411]\" data-kid=\"1-1-1-2-2-5-4-2-1\" data-name=\"surah name title\">Nisâ</p>\n<p class=\"fu mt-0.5 flex items-center gap-2 text-[11px] text-[#55605A]\" data-kid=\"1-1-1-2-2-5-4-2-2\" data-name=\"surah Arabic name and order row\">\n<span class=\"fa whitespace-nowrap text-[15px] leading-[19px] text-[#26332D]\" data-kid=\"1-1-1-2-2-5-4-2-2-1\" data-name=\"Arabic surah name\">النساء</span>\n<span data-kid=\"1-1-1-2-2-5-4-2-2-2\" data-name=\"recitation order text\">Nüzul 92</span>\n</p>\n</div>\n<span class=\"fn shrink-0 text-[12px] font-semibold text-[#55605A]\" data-kid=\"1-1-1-2-2-5-4-3\" data-name=\"surah verse count\">176 ayet</span>\n</div>\n<div class=\"flex h-[61px] items-center gap-3 border-b-2 border-[#DDE3E0] px-3.5\" data-kid=\"1-1-1-2-2-5-5\" data-name=\"surah row for Mâide\">\n<span class=\"fn w-5 shrink-0 text-[12px] font-semibold text-[#7C8881]\" data-kid=\"1-1-1-2-2-5-5-1\" data-name=\"surah number badge\">5</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-5-2\" data-name=\"surah title group\">\n<p class=\"ft truncate text-[14.5px] font-semibold leading-5 text-[#0B1411]\" data-kid=\"1-1-1-2-2-5-5-2-1\" data-name=\"surah name title\">Mâide</p>\n<p class=\"fu mt-0.5 flex items-center gap-2 text-[11px] text-[#55605A]\" data-kid=\"1-1-1-2-2-5-5-2-2\" data-name=\"surah Arabic name and order row\">\n<span class=\"fa whitespace-nowrap text-[15px] leading-[19px] text-[#26332D]\" data-kid=\"1-1-1-2-2-5-5-2-2-1\" data-name=\"Arabic surah name\">المائدة</span>\n<span data-kid=\"1-1-1-2-2-5-5-2-2-2\" data-name=\"recitation order text\">Nüzul 112</span>\n</p>\n</div>\n<span class=\"fn shrink-0 text-[12px] font-semibold text-[#55605A]\" data-kid=\"1-1-1-2-2-5-5-3\" data-name=\"surah verse count\">120 ayet</span>\n</div>\n<div class=\"flex h-[61px] items-center gap-3 border-b-2 border-[#DDE3E0] px-3.5\" data-kid=\"1-1-1-2-2-5-6\" data-name=\"surah row for En'âm\">\n<span class=\"fn w-5 shrink-0 text-[12px] font-semibold text-[#7C8881]\" data-kid=\"1-1-1-2-2-5-6-1\" data-name=\"surah number badge\">6</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-6-2\" data-name=\"surah title group\">\n<p class=\"ft truncate text-[14.5px] font-semibold leading-5 text-[#0B1411]\" data-kid=\"1-1-1-2-2-5-6-2-1\" data-name=\"surah name title\">En'âm</p>\n<p class=\"fu mt-0.5 flex items-center gap-2 text-[11px] text-[#55605A]\" data-kid=\"1-1-1-2-2-5-6-2-2\" data-name=\"surah Arabic name and order row\">\n<span class=\"fa whitespace-nowrap text-[15px] leading-[19px] text-[#26332D]\" data-kid=\"1-1-1-2-2-5-6-2-2-1\" data-name=\"Arabic surah name\">الأنعام</span>\n<span data-kid=\"1-1-1-2-2-5-6-2-2-2\" data-name=\"recitation order text\">Nüzul 55</span>\n</p>\n</div>\n<span class=\"fn shrink-0 text-[12px] font-semibold text-[#55605A]\" data-kid=\"1-1-1-2-2-5-6-3\" data-name=\"surah verse count\">165 ayet</span>\n</div>\n<div class=\"flex h-[61px] items-center gap-3 px-3.5\" data-kid=\"1-1-1-2-2-5-7\" data-name=\"surah row for A'râf\">\n<span class=\"fn w-5 shrink-0 text-[12px] font-semibold text-[#7C8881]\" data-kid=\"1-1-1-2-2-5-7-1\" data-name=\"surah number badge\">7</span>\n<div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-2-2-5-7-2\" data-name=\"surah title group\">\n<p class=\"ft truncate text-[14.5px] font-semibold leading-5 text-[#0B1411]\" data-kid=\"1-1-1-2-2-5-7-2-1\" data-name=\"surah name title\">A'râf</p>\n<p class=\"fu mt-0.5 flex items-center gap-2 text-[11px] text-[#55605A]\" data-kid=\"1-1-1-2-2-5-7-2-2\" data-name=\"surah Arabic name and order row\">\n<span class=\"fa whitespace-nowrap text-[15px] leading-[19px] text-[#26332D]\" data-kid=\"1-1-1-2-2-5-7-2-2-1\" data-name=\"Arabic surah name\">الأعراف</span>\n<span data-kid=\"1-1-1-2-2-5-7-2-2-2\" data-name=\"recitation order text\">Nüzul 39</span>\n</p>\n</div>\n<span class=\"fn shrink-0 text-[12px] font-semibold t