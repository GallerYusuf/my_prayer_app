<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.SurahPage"
             x:DataType="vm:SurahViewModel"
             Title="{Binding SurahTitle}"
             Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundDeep}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light=#EEF2FF, Dark={StaticResource BackgroundMid}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Reading toolbar -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8" Padding="20,10,20,4">
            <Border Style="{StaticResource InfoChip}" Padding="12,7">
                <Label FontSize="12" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource AccentGold}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding ShowArabic}" Value="True">
                            <Setter Property="Text" Value="Arapça: Açık" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding ShowArabic}" Value="False">
                            <Setter Property="Text" Value="Arapça: Kapalı" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleArabicCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <BoxView Grid.Column="1" HeightRequest="1" Color="Transparent" />

            <!-- Audio controls in Column 2 -->
            <Grid Grid.Column="2" WidthRequest="38" HeightRequest="38">
                <!-- Play Button -->
                <Border Style="{StaticResource IconButton}" WidthRequest="38" HeightRequest="38"
                        SemanticProperties.Description="Sureyi başlat">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PlayAudioCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsAudioLoading}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="▶" FontSize="13" TextColor="{StaticResource AccentGold}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Pause Button -->
                <Border Style="{StaticResource IconButton}" WidthRequest="38" HeightRequest="38"
                        SemanticProperties.Description="Sureyi duraklat" IsVisible="False">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PauseAudioCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <MultiTrigger TargetType="Border">
                            <MultiTrigger.Conditions>
                                <Condition Binding="{Binding IsAudioLoading}" Value="False" />
                                <Condition Binding="{Binding IsPlaying}" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="IsVisible" Value="True" />
                        </MultiTrigger>
                    </Border.Triggers>
                    <Label Text="⏸" FontSize="13" TextColor="{StaticResource AccentGold}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Loading Spinner -->
                <ActivityIndicator IsRunning="{Binding IsAudioLoading}" IsVisible="{Binding IsAudioLoading}"
                                   Color="{StaticResource AccentGold}" WidthRequest="22" HeightRequest="22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <!-- Shifted Font controls to Columns 3 & 4 -->
            <Border Grid.Column="3" Style="{StaticResource IconButton}"
                    WidthRequest="38" HeightRequest="38"
                    SemanticProperties.Description="Yazıyı küçült">
                <Label Text="A−" FontSize="13" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource AccentGold}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DecreaseFontCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource IconButton}"
                    WidthRequest="38" HeightRequest="38"
                    SemanticProperties.Description="Yazıyı büyüt">
                <Label Text="A+" FontSize="15" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource AccentGold}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding IncreaseFontCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <CollectionView x:Name="VersesView"
                        Grid.Row="1"
                        ItemsSource="{Binding Verses}"
                        SelectionMode="None"
                        Scrolled="OnVersesScrolled"
                        Margin="20,4,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:VerseItem">
                    <Border Margin="0,5" Padding="16,14"
                            StrokeThickness="1" Stroke="{StaticResource GlassStroke}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 16">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Border WidthRequest="30" HeightRequest="30"
                                        StrokeThickness="1" Stroke="#40D4AF37"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="Transparent"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding VerseNumber}"
                                           FontSize="11" FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentGold}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="{Binding PageInfo}"
                                       Style="{StaticResource BodyMuted}"
                                       FontSize="10"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding PageInfo, Converter={StaticResource StringNotEmpty}}" />
                                <BoxView Grid.Column="2" HeightRequest="1" Color="Transparent" />
                                <Border Grid.Column="3" Style="{StaticResource IconButton}"
                                        WidthRequest="38" HeightRequest="38"
                                        SemanticProperties.Description="Ayeti paylaş">
                                    <Label Text="↗" FontSize="15" TextColor="{StaticResource AccentGold}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SurahViewModel}}, Path=ShareVerseCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource IconButton}"
                                        WidthRequest="38" HeightRequest="38"
                                        SemanticProperties.Description="Favorilere ekle veya çıkar">
                                    <Label Text="♡" FontSize="16" TextColor="{StaticResource AccentGold}"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="♥" />
                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SurahViewModel}}, Path=ToggleFavoriteCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <Label Grid.Row="1"
                                   Text="{Binding ArabicText}"
                                   FontFamily="AmiriQuran"
                                   FontSize="{Binding Source={RelativeSource AncestorType={x:Type vm:SurahViewModel}}, Path=ArabicFontSize}"
                                   LineHeight="1.7"
                                   FlowDirection="RightToLeft"
                                   HorizontalTextAlignment="End"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   IsVisible="{Binding HasArabic}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={RelativeSource AncestorType={x:Type vm:SurahViewModel}}, Path=ShowArabic}"
                                                 Value="False">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <Label Grid.Row="2"
                                   Text="{Binding Text}"
                                   FontSize="{Binding Source={RelativeSource AncestorType={x:Type vm:SurahViewModel}}, Path=TranslationFontSize}"
                                   LineHeight="1.45"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Color="{StaticResource AccentEmerald}"
                           VerticalOptions="Center" HorizontalOptions="Center" />

        <!-- Bottom Controls Bar (Row 2) -->
        <VerticalStackLayout Grid.Row="2" Spacing="8" Padding="20,10" BackgroundColor="{AppThemeBinding Light=#FFFDF6, Dark={StaticResource BackgroundDeep}}">
            <!-- Hatim Update Card -->
            <Border StrokeThickness="1" Stroke="{StaticResource GlassStroke}"
                    BackgroundColor="{AppThemeBinding Light=#E0F2FE, Dark=#1E3A8A}"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10"
                    IsVisible="{Binding ShowHatimUpdateChip}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding UpdateHatimPageCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Hatim Takibini Güncelle" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentGold}" />
                        <Label Text="{Binding CurrentVisiblePage, StringFormat='Okuduğunuz sayfayı hatim planınıza kaydedin (Sayfa {0})'}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="✓" FontSize="20" TextColor="{StaticResource AccentEmerald}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Audio Player Control Bar -->
            <Border StrokeThickness="1" Stroke="{StaticResource GlassStroke}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                    StrokeShape="RoundRectangle 12"
                    Padding="14,10"
                    IsVisible="{Binding IsPlaying}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Sesli Okunuş" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentGold}" />
                        <Label Text="Mishary Rashid Al-Afasy" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    </VerticalStackLayout>
                    <!-- Pause Button (inline) -->
                    <Button Grid.Column="1" Text="Duraklat" Style="{StaticResource OutlineButton}" Command="{Binding PauseAudioCommand}" HeightRequest="36" Padding="12,0" />
                    <!-- Stop Button (inline) -->
                    <Button Grid.Column="2" Text="Kapat" Style="{StaticResource GhostButton}" Command="{Binding StopAudioCommand}" HeightRequest="36" Padding="12,0" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
