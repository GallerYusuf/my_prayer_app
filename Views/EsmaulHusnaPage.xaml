<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:data="clr-namespace:PrayerApp.Data"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.EsmaulHusnaPage"
             x:DataType="vm:EsmaulHusnaViewModel"
             Title="Esmaül Hüsna"
             Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" Padding="20,12,20,0" RowSpacing="12">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundDeep}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light=#EEF2FF, Dark={StaticResource BackgroundMid}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border Style="{StaticResource PremiumInput}">
            <Entry Placeholder="İsim veya anlam ara..."
                   Text="{Binding SearchText}"
                   ClearButtonVisibility="WhileEditing" />
        </Border>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Names}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:EsmaName">
                    <Border Margin="0,4" Padding="14,12"
                            StrokeThickness="1" Stroke="{StaticResource GlassStroke}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                            StrokeShape="RoundRectangle 14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="38" HeightRequest="38"
                                    StrokeThickness="1" Stroke="#40D4AF37"
                                    BackgroundColor="Transparent"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Number}"
                                       FontSize="12" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource AccentGold}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Transliteration}"
                                       FontSize="15" FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="{Binding Meaning}"
                                       Style="{StaticResource BodyMuted}"
                                       FontSize="12"
                                       LineHeight="1.3" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="{Binding Arabic}"
                                   FontFamily="AmiriQuran"
                                   FontSize="20"
                                   TextColor="{StaticResource AccentGold}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="1"
               Text="{Binding EmptyMessage}"
               Style="{StaticResource BodyMuted}"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               IsVisible="{Binding EmptyMessage, Converter={StaticResource StringNotEmpty}}" />
    </Grid>
</ContentPage>
