<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:models="clr-namespace:PrayerApp.Models"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        <conv:BoolToFontAttributesConverter x:Key="BoolToFontAttributes" />
    </ContentPage.Resources>

    <Grid>
        <!-- Ambient background gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundDeep}}" Offset="0.0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource BackgroundElevated}}" Offset="0.55" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundMid}}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Soft glow orbs -->
        <Ellipse WidthRequest="280" HeightRequest="280"
                 HorizontalOptions="End" VerticalOptions="Start"
                 Margin="0,-80,-60,0" Opacity="0.12">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                    <GradientStop Color="{StaticResource AccentEmerald}" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse WidthRequest="200" HeightRequest="200"
                 HorizontalOptions="Start" VerticalOptions="End"
                 Margin="-40,0,0,-60" Opacity="0.08">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                    <GradientStop Color="{StaticResource AccentGold}" Offset="0.0" />
                    <GradientStop Color="Transparent" Offset="1.0" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <ScrollView>
            <VerticalStackLayout Padding="24,20,24,36" Spacing="28">

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Greeting}"
                               Style="{StaticResource DisplayTitle}"
                               FontSize="24" />
                        <Label Text="{Binding TodayDate}"
                               Style="{StaticResource BodyMuted}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            Style="{StaticResource GlassCardCompact}"
                            Padding="14,8"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6">
                            <Label Text="◉"
                                   FontSize="10"
                                   TextColor="{StaticResource AccentEmerald}"
                                   VerticalOptions="Center" />
                            <Label Text="{Binding CityDisplay}"
                                   FontSize="13"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource AccentGold}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Hero countdown -->
                <Border StrokeThickness="1"
                        Stroke="{StaticResource GlassStroke}"
                        StrokeShape="RoundRectangle 28"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource AccentEmerald}" Opacity="0.2" Radius="32" Offset="0,12" />
                    </Border.Shadow>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E610B981" Offset="0.0" />
                            <GradientStop Color="#CC059669" Offset="0.5" />
                            <GradientStop Color="#B30F172A" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Padding="28,32" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                        <Label Text="Sonraki Vakit"
                               Style="{StaticResource SectionLabel}"
                               TextColor="{StaticResource AccentGoldSoft}"
                               HorizontalOptions="Center" />

                        <Label Grid.Row="1"
                               Text="{Binding NextPrayerName}"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,4,0,0" />

                        <Label Grid.Row="2"
                               Text="{Binding NextPrayerTime}"
                               FontSize="15"
                               TextColor="#CCFFFFFF"
                               HorizontalOptions="Center"
                               Margin="0,0,0,8" />

                        <!-- Focal countdown -->
                        <Label Grid.Row="3"
                               Text="{Binding RemainingTime}"
                               FontFamily="OpenSansRegular"
                               FontSize="58"
                               CharacterSpacing="3"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               Margin="0,4,0,0" />

                        <Label Grid.Row="4"
                               Text="kaldı"
                               FontSize="13"
                               TextColor="#99FFFFFF"
                               HorizontalOptions="Center"
                               Margin="0,-4,0,16" />

                        <ProgressBar Grid.Row="4"
                                     VerticalOptions="End"
                                     Progress="{Binding DayProgress}"
                                     ProgressColor="{StaticResource AccentGold}"
                                     BackgroundColor="#33FFFFFF"
                                     HeightRequest="4"
                                     Margin="0,28,0,0" />
                    </Grid>
                </Border>

                <!-- Prayer times -->
                <VerticalStackLayout Spacing="14">
                    <Label Text="Bugünün Vakitleri"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                    <Border Style="{StaticResource GlassCard}" Padding="12">
                        <CollectionView ItemsSource="{Binding PrayerTimes}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PrayerTime">
                                    <Grid Padding="0,3">
                                        <Border Padding="16,14"
                                                StrokeThickness="1"
                                                Stroke="Transparent"
                                                BackgroundColor="Transparent"
                                                StrokeShape="RoundRectangle 16">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                                <Border WidthRequest="44"
                                                        HeightRequest="44"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#1AFFFFFF"
                                                        StrokeShape="RoundRectangle 14"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Glyph}"
                                                           FontSize="20"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1"
                                                                     Spacing="2"
                                                                     VerticalOptions="Center">
                                                    <Label Text="{Binding TurkishName}"
                                                           FontSize="16"
                                                           FontAttributes="{Binding IsNext, Converter={StaticResource BoolToFontAttributes}}"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                    <Label Text="Sıradaki vakit"
                                                           FontSize="11"
                                                           TextColor="{StaticResource AccentGold}"
                                                           IsVisible="{Binding IsNext}" />
                                                </VerticalStackLayout>

                                                <Label Grid.Column="2"
                                                       Text="{Binding Time, Converter={StaticResource TimeSpanToString}}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="17"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </Grid>

                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border"
                                                             Binding="{Binding IsNext}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#1A10B981" />
                                                    <Setter Property="Stroke" Value="#4010B981" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>

                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid"
                                                         Binding="{Binding IsPassed}"
                                                         Value="True">
                                                <Setter Property="Opacity" Value="0.38" />
                                            </DataTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>
                </VerticalStackLayout>

                <!-- Verse card -->
                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="20">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="﴿"
                                       FontSize="22"
                                       TextColor="{StaticResource AccentGold}"
                                       VerticalOptions="Center" />
                                <Label Text="Günün Ayeti"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="1"
                                    Style="{StaticResource IconButton}">
                                <Label Text="↻"
                                       FontSize="20"
                                       TextColor="{StaticResource AccentGold}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RefreshVerseCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{StaticResource GlassStroke}"
                                 Margin="0,-4,0,0" />

                        <Label Text="{Binding VerseOfDay}"
                               Style="{StaticResource VerseBody}" />

                        <Label Text="{Binding VerseReference}"
                               FontFamily="OpenSansSemibold"
                               FontSize="13"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource AccentGold}" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource AccentEmerald}"
                                   HeightRequest="32"
                                   WidthRequest="32"
                                   HorizontalOptions="Center" />

                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        StrokeThickness="1"
                        Stroke="#40F87171"
                        BackgroundColor="#1AF87171"
                        StrokeShape="RoundRectangle 14"
                        Padding="16,12">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{StaticResource Error}"
                           HorizontalTextAlignment="Center"
                           FontSize="14" />
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
