<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:models="clr-namespace:PrayerApp.Models"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        <conv:BoolToFontAttributesConverter x:Key="BoolToFontAttributes" />
        <conv:ProgressToPercentConverter x:Key="ProgressToPercent" />
        <conv:InverseBoolConverter x:Key="InverseBool" />

        <LinearGradientBrush x:Key="HeroBrushDawn" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroDawnStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroDawnEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrushMorning" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroMorningStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroMorningEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrushDay" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroDayStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroDayEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrushSunset" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroSunsetStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroSunsetEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrushNight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroNightStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroNightEnd}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding RefreshPrayerTimesCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16,14,16,28" Spacing="16">

                <!-- 1. TOP BAR: Direct City Picker + Date + Settings Button -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <!-- Direct City Picker Trigger -->
                        <Border Style="{StaticResource InfoChip}"
                                Padding="12,7"
                                HorizontalOptions="Start"
                                SemanticProperties.Description="Şehir seçmek için dokunun">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCityPickerCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6">
                                <Image Source="icon_pin.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                                <Label Text="{Binding CityDisplay}"
                                       FontSize="14"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentGold}}"
                                       VerticalOptions="Center" />
                                <Label Text="▾"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Gregorian & Hijri Date -->
                        <Label Style="{StaticResource BodyMuted}" FontSize="12" Margin="2,0,0,0">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding TodayDate}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding HijriDate}" FontFamily="OpenSansSemibold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <!-- Settings Button -->
                    <Border Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            VerticalOptions="Start"
                            SemanticProperties.Description="Ayarları aç">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="settings.png"
                               WidthRequest="20"
                               HeightRequest="20"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- 2. RAMADAN PRIORITY BANNER (when active) -->
                <Border IsVisible="{Binding IsRamadanVisible}"
                        StrokeThickness="1"
                        Stroke="#50D4AF37"
                        BackgroundColor="{AppThemeBinding Light=#FDF8EC, Dark=#1D180D}"
                        StrokeShape="RoundRectangle 18"
                        Padding="16,14">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6">
                        <Label Text="{Binding RamadanDayText}"
                               Style="{StaticResource SectionLabel}" />
                        <Label Grid.Column="1"
                               Text="{Binding RamadanCountdownLabel}"
                               Style="{StaticResource BodyMuted}"
                               FontSize="12"
                               HorizontalOptions="End" />

                        <HorizontalStackLayout Grid.Row="1" Spacing="14" VerticalOptions="Center">
                            <Label Text="{Binding RamadanSahurTime, StringFormat='İmsak {0}'}"
                                   FontSize="13" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding RamadanIftarTime, StringFormat='İftar {0}'}"
                                   FontSize="13" FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource AccentEmerald}" />
                        </HorizontalStackLayout>

                        <Label Grid.Row="1" Grid.Column="1"
                               Text="{Binding RamadanCountdown}"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="{AppThemeBinding Light={StaticResource AccentGoldMuted}, Dark={StaticResource AccentGold}}"
                               HorizontalOptions="End" />
                    </Grid>
                </Border>

                <!-- 3. UNIFIED HERO COUNTDOWN CARD (No duplicate counters; honest state when no data) -->
                <Border x:Name="HeroCard"
                        Style="{StaticResource HeroCard}"
                        Background="{StaticResource HeroBrushDay}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding DayPeriod}" Value="dawn">
                            <Setter Property="Background" Value="{StaticResource HeroBrushDawn}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding DayPeriod}" Value="morning">
                            <Setter Property="Background" Value="{StaticResource HeroBrushMorning}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding DayPeriod}" Value="sunset">
                            <Setter Property="Background" Value="{StaticResource HeroBrushSunset}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Border" Binding="{Binding DayPeriod}" Value="night">
                            <Setter Property="Background" Value="{StaticResource HeroBrushNight}" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Grid Padding="20,18">
                        <!-- Active Schedule State -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding HasScheduleData}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="SIRADAKİ VAKİT"
                                           FontSize="11"
                                           FontFamily="OpenSansSemibold"
                                           CharacterSpacing="1.5"
                                           TextColor="#CCFFFFFF" />
                                    <Label Text="{Binding NextPrayerName}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="28"
                                           TextColor="{StaticResource White}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        BackgroundColor="#26FFFFFF"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="14,8"
                                        VerticalOptions="Center">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                                        <Label Text="Vakit saati" FontSize="10" TextColor="#BBFFFFFF" HorizontalOptions="Center" />
                                        <Label Text="{Binding NextPrayerTime}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="18"
                                               TextColor="{StaticResource AccentGoldSoft}"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Single, non-jumping countdown row -->
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="End">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Kalan süre" FontSize="12" TextColor="#BBFFFFFF" />
                                    <Label Text="{Binding RemainingTime}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="42"
                                           HeightRequest="52"
                                           VerticalTextAlignment="Center"
                                           CharacterSpacing="2"
                                           TextColor="{StaticResource White}" />
                                </VerticalStackLayout>

                                <!-- Kerahat badge if active -->
                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        BackgroundColor="#40EF4444"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,6"
                                        VerticalOptions="End"
                                        IsVisible="{Binding KerahatText, Converter={StaticResource StringNotEmptyConverter}}">
                                    <Label Text="{Binding KerahatText}"
                                           FontSize="11"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="#FECACA" />
                                </Border>
                            </Grid>

                            <!-- Progress bar + Data freshness / Offline indicator -->
                            <VerticalStackLayout Spacing="6">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#25FFFFFF"
                                        StrokeShape="RoundRectangle 4"
                                        HeightRequest="5">
                                    <ProgressBar Progress="{Binding DayProgress}"
                                                 ProgressColor="{StaticResource AccentGold}"
                                                 BackgroundColor="Transparent"
                                                 HeightRequest="5" />
                                </Border>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding DataStatusText}"
                                           FontSize="11"
                                           TextColor="#BBFFFFFF"
                                           IsVisible="{Binding DataStatusText, Converter={StaticResource StringNotEmptyConverter}}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding TrackProgressText}"
                                           FontSize="11"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentEmeraldSoft}" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Honest No-Data State (No misleading countdown!) -->
                        <VerticalStackLayout Spacing="10"
                                             Padding="4,8"
                                             IsVisible="{Binding HasScheduleData, Converter={StaticResource InverseBool}}">
                            <Label Text="Vakit Verisi Bekleniyor"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="{StaticResource White}" />
                            <Label Text="Seçili konum için bugüne ait kayıtlı namaz vakti bulunamadı. İnternet bağlantınızı kontrol edip yenileyin veya başka bir şehir seçin."
                                   FontSize="13"
                                   LineHeight="1.4"
                                   TextColor="#DDFFFFFF" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                                <Button Text="Vakitleri İndir"
                                        BackgroundColor="{StaticResource AccentGold}"
                                        TextColor="{StaticResource BackgroundDeep}"
                                        FontFamily="OpenSansSemibold"
                                        Command="{Binding RefreshPrayerTimesCommand}" />
                                <Button Grid.Column="1"
                                        Text="Şehir Değiştir"
                                        BackgroundColor="#28FFFFFF"
                                        TextColor="{StaticResource White}"
                                        FontFamily="OpenSansSemibold"
                                        Command="{Binding OpenCityPickerCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Error Banner (if network refresh failed) -->
                <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        StrokeThickness="1"
                        Stroke="#40EF4444"
                        BackgroundColor="#14EF4444"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Error}"
                               FontSize="13"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Yenile"
                                Style="{StaticResource GhostButton}"
                                TextColor="{StaticResource Error}"
                                Command="{Binding RefreshPrayerTimesCommand}" />
                    </Grid>
                </Border>

                <!-- 4. UNIFIED TODAY'S PRAYER TIMES & "KILDIM" TRACKING (No duplicate lists!) -->
                <Border Style="{StaticResource GlassCard}" Padding="14,12" IsVisible="{Binding HasScheduleData}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="GÜNÜN VAKİTLERİ" Style="{StaticResource SectionLabel}" />
                                <Label Text="Farz vakitleri kıldıkça sağdan işaretleyebilirsiniz" Style="{StaticResource BodyMuted}" FontSize="11" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" Style="{StaticResource InfoChip}" Padding="10,5" VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenCalendarCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Takvim ›" FontSize="12" FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentGold}}" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PrayerTimes}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PrayerTime">
                                    <Border Padding="12,10"
                                            StrokeThickness="1"
                                            Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                            StrokeShape="RoundRectangle 12">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#14059669, Dark=#2210B981}" />
                                                <Setter Property="Stroke" Value="#6010B981" />
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <!-- Prayer Icon -->
                                            <Image Source="{Binding Icon}"
                                                   WidthRequest="20"
                                                   HeightRequest="20"
                                                   VerticalOptions="Center" />

                                            <!-- Prayer Name + Next/Sunrise Badge (Visually separated from Kıldım!) -->
                                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding TurkishName}"
                                                       FontSize="15"
                                                       FontAttributes="{Binding IsNext, Converter={StaticResource BoolToFontAttributes}}"
                                                       VerticalOptions="Center" />

                                                <Border Padding="7,2"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 8"
                                                        BackgroundColor="#2510B981"
                                                        VerticalOptions="Center"
                                                        IsVisible="{Binding HasStateBadge}">
                                                    <Label Text="{Binding StateBadgeText}"
                                                           FontSize="10"
                                                           FontFamily="OpenSansSemibold"
                                                           TextColor="{StaticResource AccentEmerald}" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <!-- Prayer Time -->
                                            <Label Grid.Column="2"
                                                   Text="{Binding Time, Converter={StaticResource TimeSpanToString}}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   Margin="0,0,4,0" />

                                            <!-- Distinct "Kıldım" Toggle Pill (only for the 5 obligatory prayers) -->
                                            <Border Grid.Column="3"
                                                    Padding="10,6"
                                                    MinimumWidthRequest="76"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource HairLine}, Dark={StaticResource HairLineDark}}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                                    StrokeShape="RoundRectangle 10"
                                                    VerticalOptions="Center"
                                                    IsVisible="{Binding IsTrackable}"
                                                    SemanticProperties.Description="Kıldım olarak işaretle">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=TogglePrayerTimeCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#2010B981" />
                                                        <Setter Property="Stroke" Value="#6010B981" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding TrackButtonText}"
                                                       FontSize="11"
                                                       FontFamily="OpenSansSemibold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource AccentEmerald}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 5. PROMINENT DAILY FLOWS: Continue Quran + Qibla & Dhikr -->
                <VerticalStackLayout Spacing="10">
                    <!-- Continue Quran Card -->
                    <Border Style="{StaticResource GlassCard}" Padding="16,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ContinueQuranCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="42" HeightRequest="42"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                    VerticalOptions="Center">
                                <Image Source="tab_quran.png" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="KUR'AN OKUMAYA DEVAM ET" Style="{StaticResource SectionLabel}" FontSize="10" />
                                <Label Text="{Binding QuranResumeTitle}" FontSize="15" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding QuranResumeSubtitle}" Style="{StaticResource BodyMuted}" FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="Oku ›"
                                   FontSize="13" FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource AccentEmerald}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Qibla & Dhikr Prominent Pair -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource GlassCardCompact}"
                                SemanticProperties.Description="Kıble pusulasını aç">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenQiblaCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border WidthRequest="38" HeightRequest="38"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                        VerticalOptions="Center">
                                    <Image Source="tab_qibla.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Kıble Pusulası" FontSize="14" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding QiblaSummaryText}" Style="{StaticResource BodyMuted}" FontSize="11" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource GlassCardCompact}"
                                SemanticProperties.Description="Zikirmatiği aç">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenDhikrCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border WidthRequest="38" HeightRequest="38"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                        VerticalOptions="Center">
                                    <Image Source="tab_worship.png" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Zikirmatik" FontSize="14" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding DhikrSummaryText}" Style="{StaticResource BodyMuted}" FontSize="11" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- 6. CALM VERSE OF THE DAY CARD -->
                <Border Style="{StaticResource GlassCard}" Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Label Text="GÜNÜN AYETİ" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                            <Button Grid.Column="1"
                                    Text="Başka Ayet"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8,4"
                                    MinimumHeightRequest="32"
                                    Command="{Binding RefreshVerseCommand}" />
                            <Button Grid.Column="2"
                                    Text="Kur'an'da Aç ›"
                                    Style="{StaticResource GhostButton}"
                                    Padding="8,4"
                                    MinimumHeightRequest="32"
                                    TextColor="{StaticResource AccentEmerald}"
                                    Command="{Binding OpenVerseInQuranCommand}" />
                        </Grid>

                        <Label Text="{Binding VerseOfDay}" Style="{StaticResource VerseBody}" />

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Label Text="{Binding VerseReference}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource AccentGoldMuted}, Dark={StaticResource AccentGold}}"
                                   VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="Kopyala"
                                    Style="{StaticResource GhostButton}"
                                    Padding="10,4"
                                    MinimumHeightRequest="34"
                                    Command="{Binding CopyVerseCommand}" />
                            <Button Grid.Column="2"
                                    Text="Paylaş"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="12,4"
                                    MinimumHeightRequest="34"
                                    Command="{Binding ShareVerseCommand}" />
                        </Grid>

                        <Label Text="{Binding VerseActionMessage}"
                               FontSize="12"
                               TextColor="{StaticResource AccentEmerald}"
                               IsVisible="{Binding VerseActionMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HeightRequest="28"
                                   WidthRequest="28"
                                   HorizontalOptions="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
