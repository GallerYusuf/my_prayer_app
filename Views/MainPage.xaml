<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:models="clr-namespace:PrayerApp.Models"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        <conv:BoolToFontAttributesConverter x:Key="BoolToFontAttributes" />
        <conv:ProgressToPercentConverter x:Key="ProgressToPercent" />

        <LinearGradientBrush x:Key="HeroBrushDawn" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroDawnStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroDawnEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrushMorning" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroMorningStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroMorningEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrushDay" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroDayStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroDayEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrushSunset" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroSunsetStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroSunsetEnd}" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroBrushNight" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource HeroNightStart}" Offset="0" />
            <GradientStop Color="{StaticResource HeroNightEnd}" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundDeep}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light=#EEF2FF, Dark={StaticResource BackgroundMid}}" Offset="0.45" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundDeep}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse WidthRequest="320" HeightRequest="320"
                 HorizontalOptions="End" VerticalOptions="Start"
                 Margin="0,-100,-80,0" Opacity="0.1">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                    <GradientStop Color="{StaticResource AccentEmerald}" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshPrayerTimesCommand}"
                     RefreshColor="{StaticResource AccentGold}">
            <ScrollView>
                <VerticalStackLayout Padding="20,16,20,32" Spacing="22">

                    <!-- Brand + greeting -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ezan Vakti"
                               Style="{StaticResource SectionLabel}"
                               FontSize="11"
                               CharacterSpacing="3" />
                        <Label Text="{Binding Greeting}"
                               Style="{StaticResource DisplayTitle}"
                               FontSize="26" />
                        <Label Text="{Binding TodayDate}"
                               Style="{StaticResource BodyMuted}"
                               FontSize="13" />
                    </VerticalStackLayout>

                    <!-- Info chips -->
                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource InfoChip}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="☪"
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding HijriDate}"
                                           FontSize="12"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border Style="{StaticResource InfoChip}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="📍"
                                           FontSize="12"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding CityDisplay}"
                                           FontSize="12"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentGold}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Style="{StaticResource InfoChip}">
                                <Label Text="{Binding PrayerProgressText}"
                                       FontSize="12"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource AccentEmeraldSoft}"
                                       VerticalOptions="Center" />
                            </Border>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Ramazan modu -->
                    <Border IsVisible="{Binding IsRamadanVisible}"
                            StrokeThickness="1"
                            Stroke="#40D4AF37"
                            StrokeShape="RoundRectangle 22"
                            Padding="18,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#CC78350F" Offset="0" />
                                <GradientStop Color="#B3591305" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">
                            <Label Text="Ramazan"
                                   Style="{StaticResource SectionLabel}"
                                   TextColor="{StaticResource AccentGoldSoft}"
                                   FontSize="10" />
                            <Label Grid.Column="1"
                                   Text="{Binding RamadanDayText}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   TextColor="{StaticResource AccentGold}"
                                   HorizontalOptions="End" />

                            <Label Grid.Row="1" Grid.ColumnSpan="2"
                                   Text="{Binding RamadanCountdownLabel}"
                                   FontSize="13"
                                   TextColor="#CCFFFFFF" />

                            <Label Grid.Row="2"
                                   Text="{Binding RamadanCountdown}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="36"
                                   TextColor="{StaticResource White}" />

                            <VerticalStackLayout Grid.Row="2" Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="End"
                                                 HorizontalOptions="End">
                                <Label Text="{Binding RamadanIftarTime, StringFormat='İftar {0}'}"
                                       FontSize="12"
                                       TextColor="#DDFFFFFF"
                                       HorizontalOptions="End" />
                                <Label Text="{Binding RamadanSahurTime, StringFormat='Sahur {0}'}"
                                       FontSize="12"
                                       TextColor="#DDFFFFFF"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Hero countdown -->
                    <Border x:Name="HeroCard"
                            Style="{StaticResource HeroCard}"
                            Background="{StaticResource HeroBrushDay}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding DayPeriod}" Value="dawn">
                                <Setter Property="Background" Value="{StaticResource HeroBrushDawn}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding DayPeriod}" Value="morning">
                                <Setter Property="Background" Value="{StaticResource HeroBrushMorning}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding DayPeriod}" Value="sunset">
                                <Setter Property="Background" Value="{StaticResource HeroBrushSunset}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding DayPeriod}" Value="night">
                                <Setter Property="Background" Value="{StaticResource HeroBrushNight}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid Padding="24,26" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="0">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Sonraki Vakit"
                                           Style="{StaticResource SectionLabel}"
                                           TextColor="#CCFFFFFF"
                                           FontSize="10" />
                                    <Label Text="{Binding NextPrayerName}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="32"
                                           TextColor="{StaticResource White}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeThickness="0"
                                        BackgroundColor="#30FFFFFF"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="12,6"
                                        VerticalOptions="Start">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="🕐"
                                               FontSize="11"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding NextPrayerTime}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14"
                                               TextColor="{StaticResource White}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <Label Grid.Row="1"
                                   Text="Kalan süre"
                                   FontSize="12"
                                   TextColor="#99FFFFFF"
                                   Margin="0,6,0,0" />

                            <!-- Unified countdown -->
                            <Label Grid.Row="2"
                                   Text="{Binding RemainingTime}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="52"
                                   CharacterSpacing="4"
                                   TextColor="{StaticResource White}"
                                   Margin="0,8,0,0" />

                            <!-- Segmented breakdown -->
                            <Grid Grid.Row="3"
                                  ColumnDefinitions="*,Auto,*,Auto,*"
                                  Margin="0,18,0,0">
                                <Border Grid.Column="0" Style="{StaticResource CountdownBox}">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding RemainingHours}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="24"
                                               TextColor="{StaticResource White}"
                                               HorizontalOptions="Center" />
                                        <Label Text="saat"
                                               FontSize="10"
                                               TextColor="#AAFFFFFF"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <Label Grid.Column="1" Text=":" FontSize="22" TextColor="#55FFFFFF"
                                       VerticalOptions="Center" Margin="4,0,4,6" />
                                <Border Grid.Column="2" Style="{StaticResource CountdownBox}">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding RemainingMinutes}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="24"
                                               TextColor="{StaticResource White}"
                                               HorizontalOptions="Center" />
                                        <Label Text="dk"
                                               FontSize="10"
                                               TextColor="#AAFFFFFF"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <Label Grid.Column="3" Text=":" FontSize="22" TextColor="#55FFFFFF"
                                       VerticalOptions="Center" Margin="4,0,4,6" />
                                <Border Grid.Column="4" Style="{StaticResource CountdownBox}">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding RemainingSeconds}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="24"
                                               TextColor="{StaticResource White}"
                                               HorizontalOptions="Center" />
                                        <Label Text="sn"
                                               FontSize="10"
                                               TextColor="#AAFFFFFF"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Progress -->
                            <Grid Grid.Row="4" Margin="0,20,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Border StrokeThickness="0"
                                        BackgroundColor="#25FFFFFF"
                                        StrokeShape="RoundRectangle 4"
                                        HeightRequest="5"
                                        VerticalOptions="Center">
                                    <ProgressBar Progress="{Binding DayProgress}"
                                                 ProgressColor="{StaticResource AccentGold}"
                                                 BackgroundColor="Transparent"
                                                 HeightRequest="5" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="{Binding DayProgress, Converter={StaticResource ProgressToPercent}}"
                                       FontSize="11"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="#BBFFFFFF"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Horizontal prayer timeline -->
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Vakitler"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="17"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Aşağı kaydır ↓"
                                   Style="{StaticResource BodyMuted}"
                                   FontSize="11"
                                   VerticalOptions="Center"
                                   Opacity="0.6" />
                        </Grid>

                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <CollectionView ItemsSource="{Binding PrayerTimes}"
                                            SelectionMode="None"
                                            HeightRequest="108">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PrayerTime">
                                        <Border WidthRequest="88"
                                                Margin="0,0,10,0"
                                                StrokeThickness="1"
                                                Stroke="{StaticResource GlassStroke}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                                StrokeShape="RoundRectangle 18"
                                                Padding="12,14">
                                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                                <Label Text="{Binding Glyph}"
                                                       FontSize="22"
                                                       HorizontalOptions="Center" />
                                                <Label Text="{Binding TurkishName}"
                                                       FontSize="12"
                                                       FontFamily="OpenSansSemibold"
                                                       HorizontalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                <Label Text="{Binding Time, Converter={StaticResource TimeSpanToString}}"
                                                       FontSize="14"
                                                       FontFamily="OpenSansSemibold"
                                                       HorizontalOptions="Center"
                                                       TextColor="{StaticResource AccentGold}" />
                                            </VerticalStackLayout>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                                    <Setter Property="Stroke" Value="#6010B981" />
                                                    <Setter Property="BackgroundColor" Value="#2510B981" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsPassed}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Namaz takibi -->
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Namaz Takibi"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="17"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Border Style="{StaticResource InfoChip}" Padding="8,4">
                                    <Label Text="{Binding TrackProgressText}"
                                           FontSize="11"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentEmerald}" />
                                </Border>
                                <Border Style="{StaticResource InfoChip}" Padding="8,4"
                                        IsVisible="{Binding TrackStreak}">
                                    <Label Text="{Binding TrackStreak, StringFormat='🔥 {0} gün'}"
                                           FontSize="11"
                                           FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentGold}" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <CollectionView ItemsSource="{Binding TrackItems}"
                                        SelectionMode="None"
                                        HeightRequest="100">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Horizontal"
                                                 Span="5"
                                                 HorizontalItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PrayerTrackItem">
                                    <Border StrokeThickness="1"
                                            Stroke="{StaticResource GlassStroke}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                            StrokeShape="RoundRectangle 16"
                                            Padding="8,12"
                                            WidthRequest="64">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=TogglePrayerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                            <Label Text="{Binding Glyph}" FontSize="20" HorizontalOptions="Center" />
                                            <Label Text="{Binding TurkishName}"
                                                   FontSize="11"
                                                   FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label Text="✓"
                                                   FontSize="14"
                                                   FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource AccentEmerald}"
                                                   HorizontalOptions="Center"
                                                   IsVisible="{Binding IsCompleted}" />
                                        </VerticalStackLayout>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#2010B981" />
                                                <Setter Property="Stroke" Value="#5010B981" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Label Text="Kıldığınız vakitlere dokunarak işaretleyin"
                               Style="{StaticResource BodyMuted}"
                               FontSize="12"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <!-- Detailed prayer list -->
                    <Border Style="{StaticResource GlassCard}" Padding="8">
                        <CollectionView ItemsSource="{Binding PrayerTimes}"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:PrayerTime">
                                    <Grid Padding="0,2">
                                        <Border Padding="14,12"
                                                StrokeThickness="1"
                                                Stroke="Transparent"
                                                BackgroundColor="Transparent"
                                                StrokeShape="RoundRectangle 14">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                                <Border WidthRequest="40"
                                                        HeightRequest="40"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark=#1AFFFFFF}"
                                                        StrokeShape="RoundRectangle 12"
                                                        VerticalOptions="Center">
                                                    <Label Text="{Binding Glyph}"
                                                           FontSize="18"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding TurkishName}"
                                                           FontSize="15"
                                                           FontAttributes="{Binding IsNext, Converter={StaticResource BoolToFontAttributes}}"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                                    <Label Text="Sıradaki"
                                                           FontSize="10"
                                                           TextColor="{StaticResource AccentEmerald}"
                                                           IsVisible="{Binding IsNext}" />
                                                </VerticalStackLayout>

                                                <Label Grid.Column="2"
                                                       Text="{Binding Time, Converter={StaticResource TimeSpanToString}}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="16"
                                                       VerticalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            </Grid>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsNext}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#1410B981" />
                                                    <Setter Property="Stroke" Value="#3010B981" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Grid.Triggers>
                                            <DataTrigger TargetType="Grid" Binding="{Binding IsPassed}" Value="True">
                                                <Setter Property="Opacity" Value="0.4" />
                                            </DataTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <!-- Verse card -->
                    <Border Style="{StaticResource GlassCard}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label Text="﴿"
                                           FontSize="20"
                                           TextColor="{StaticResource AccentGold}"
                                           VerticalOptions="Center" />
                                    <Label Text="Günün Ayeti"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Border Grid.Column="1"
                                        Style="{StaticResource IconButton}"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Margin="0,0,8,0">
                                    <Label Text="↗"
                                           FontSize="16"
                                           TextColor="{StaticResource AccentGold}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShareVerseCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        WidthRequest="40"
                                        HeightRequest="40">
                                    <Label Text="↻"
                                           FontSize="18"
                                           TextColor="{StaticResource AccentGold}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding RefreshVerseCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{StaticResource GlassStroke}" />

                            <Label Text="{Binding VerseOfDay}"
                                   Style="{StaticResource VerseBody}" />

                            <Label Text="{Binding VerseReference}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource AccentGold}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Paylaş"
                                        Style="{StaticResource OutlineButton}"
                                        Command="{Binding ShareVerseCommand}" />
                                <Button Grid.Column="1"
                                        Text="Kopyala"
                                        Style="{StaticResource GhostButton}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                        TextColor="{StaticResource AccentEmerald}"
                                        CornerRadius="14"
                                        Command="{Binding CopyVerseCommand}" />
                            </Grid>

                            <Label Text="{Binding VerseActionMessage}"
                                   FontSize="12"
                                   TextColor="{StaticResource AccentEmerald}"
                                   HorizontalTextAlignment="Center"
                                   IsVisible="{Binding VerseActionMessage, Converter={StaticResource StringNotEmptyConverter}}" />
                        </VerticalStackLayout>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource AccentEmerald}"
                                       HeightRequest="32"
                                       WidthRequest="32"
                                       HorizontalOptions="Center" />

                    <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                            StrokeThickness="1"
                            Stroke="#40F87171"
                            BackgroundColor="#1AF87171"
                            StrokeShape="RoundRectangle 14"
                            Padding="16,12">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="{StaticResource Error}"
                                   HorizontalTextAlignment="Center"
                                   FontSize="14" />
                            <Button Text="Tekrar Dene"
                                    Style="{StaticResource GhostButton}"
                                    TextColor="{StaticResource Error}"
                                    Command="{Binding RefreshPrayerTimesCommand}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
