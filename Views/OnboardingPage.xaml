<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:models="clr-namespace:PrayerApp.Models"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="24,32,24,24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundDeep}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light=#EEF2FF, Dark={StaticResource BackgroundMid}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Step indicator -->
        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <BoxView WidthRequest="28" HeightRequest="4" CornerRadius="2" Color="{StaticResource AccentGold}" />
            <BoxView WidthRequest="28" HeightRequest="4" CornerRadius="2" Color="{StaticResource AccentGold}"
                     Opacity="{Binding Indicator2Opacity}" />
            <BoxView WidthRequest="28" HeightRequest="4" CornerRadius="2" Color="{StaticResource AccentGold}"
                     Opacity="{Binding Indicator3Opacity}" />
            <BoxView WidthRequest="28" HeightRequest="4" CornerRadius="2" Color="{StaticResource AccentGold}"
                     Opacity="{Binding Indicator4Opacity}" />
        </HorizontalStackLayout>

        <!-- STEP 0: Welcome -->
        <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center"
                             IsVisible="{Binding IsStep0}">
            <Label Text="Ezan Vakti"
                   Style="{StaticResource DisplayTitle}"
                   FontSize="34"
                   HorizontalTextAlignment="Center" />
            <Label Text="Namaz vakitleri, kıble, Kur'an meali ve zikir sayacı — hepsi tek uygulamada, internetsiz de çalışır."
                   Style="{StaticResource BodyMuted}"
                   FontSize="16"
                   HorizontalTextAlignment="Center" />
            <Border Style="{StaticResource GlassCard}" Margin="0,12,0,0">
                <VerticalStackLayout Spacing="14">
                    <Label Text="• Diyanet uyumlu vakit hesabı" Style="{StaticResource BodyMuted}" FontSize="14" />
                    <Label Text="• Uygulama kapalıyken bile vakit bildirimleri" Style="{StaticResource BodyMuted}" FontSize="14" />
                    <Label Text="• Verileriniz cihazınızda kalır; hesap ve reklam yok" Style="{StaticResource BodyMuted}" FontSize="14" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- STEP 1: Location -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*"
              IsVisible="{Binding IsStep1}"
              RowSpacing="14"
              Margin="0,20,0,0">
            <VerticalStackLayout Spacing="6">
                <Label Text="Konumunuz" Style="{StaticResource DisplayTitle}" FontSize="26" />
                <Label Text="Vakitler ve kıble yönü için konum gerekir. Konum yalnızca bu hesaplamalar için kullanılır, hiçbir yerde saklanmaz."
                       Style="{StaticResource BodyMuted}" FontSize="14" />
            </VerticalStackLayout>

            <Button Grid.Row="1"
                    Text="Konumumu Kullan"
                    Style="{StaticResource PremiumButton}"
                    Command="{Binding UseDeviceLocationCommand}"
                    IsEnabled="{Binding IsLocating, Converter={StaticResource InverseBool}}" />

            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Border IsVisible="{Binding HasLocation}"
                        StrokeThickness="1" Stroke="#5010B981" BackgroundColor="#2010B981"
                        StrokeShape="RoundRectangle 12" Padding="12,10">
                    <Label Text="{Binding LocationSummary, StringFormat='Seçilen konum: {0}'}"
                           TextColor="{StaticResource AccentEmerald}" FontSize="13" />
                </Border>
                <Label Text="{Binding LocationError}"
                       TextColor="{StaticResource Error}" FontSize="13"
                       IsVisible="{Binding LocationError, Converter={StaticResource StringNotEmpty}}" />
                <Label Text="veya şehir seçin" Style="{StaticResource BodyMuted}" FontSize="13" />
                <Border Style="{StaticResource PremiumInput}">
                    <Entry Placeholder="Şehir ara..." Text="{Binding CitySearch}" />
                </Border>
            </VerticalStackLayout>

            <CollectionView Grid.Row="3" ItemsSource="{Binding FilteredCities}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TurkishCity">
                        <Border Margin="0,3" Padding="14,12"
                                StrokeThickness="1" Stroke="{StaticResource GlassStroke}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OnboardingViewModel}}, Path=SelectCityCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="{Binding PlateLabel}" TextColor="{StaticResource AccentGold}"
                                       FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding DisplayName}" Margin="12,0,0,0"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="15" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- STEP 2: Method + theme -->
        <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center"
                             IsVisible="{Binding IsStep2}">
            <Label Text="Görünüm" Style="{StaticResource DisplayTitle}" FontSize="26" />
            <Label Text="Vakitler Diyanet İşleri Başkanlığı yöntemiyle hesaplanır; dilerseniz ayarlardan değiştirebilirsiniz."
                   Style="{StaticResource BodyMuted}" FontSize="14" />
            <Border Style="{StaticResource GlassCard}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Tema" FontFamily="OpenSansSemibold" FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Picker SelectedIndex="{Binding ThemeIndex}"
                            Title="Tema seçin">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Sistem temasına uy</x:String>
                                <x:String>Açık tema</x:String>
                                <x:String>Koyu tema</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <!-- STEP 3: Notifications + privacy -->
        <VerticalStackLayout Grid.Row="1" Spacing="20" VerticalOptions="Center"
                             IsVisible="{Binding IsStep3}">
            <Label Text="Bildirimler" Style="{StaticResource DisplayTitle}" FontSize="26" />
            <Label Text="Namaz vakitlerinde ve günün ayetinde bildirim almak için izin gerekir. İzin, 'Başla' dediğinizde sorulur."
                   Style="{StaticResource BodyMuted}" FontSize="14" />
            <Border Style="{StaticResource GlassCard}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Vakit bildirimleri" FontFamily="OpenSansSemibold" FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Uygulama kapalıyken de çalışır" Style="{StaticResource BodyMuted}" FontSize="12" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" Style="{StaticResource PremiumSwitch}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource GlassCardCompact}">
                <Label Text="Gizlilik: Verileriniz cihazınızda saklanır. Konumunuz yalnızca vakit hesaplamak için namaz vakti servisine iletilir; hesap, analiz veya reklam yoktur."
                       Style="{StaticResource BodyMuted}" FontSize="12" />
            </Border>
        </VerticalStackLayout>

        <!-- Navigation buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Text="Geri"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding IsNotFirstStep}" />

            <Button Grid.Column="1"
                    Text="{Binding NextButtonText}"
                    Style="{StaticResource PremiumButton}"
                    Command="{Binding NextCommand}"
                    IsEnabled="{Binding IsFinishing, Converter={StaticResource InverseBool}}" />
        </Grid>
    </Grid>
</ContentPage>
