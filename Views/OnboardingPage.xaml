<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:models="clr-namespace:PrayerApp.Models"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.OnboardingPage"
             x:DataType="vm:OnboardingViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,24,20,20" RowSpacing="14">

        <!-- 2-Step Progress Indicator -->
        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
            <BoxView WidthRequest="44" HeightRequest="4" CornerRadius="2" Color="{StaticResource AccentEmerald}" />
            <BoxView WidthRequest="44" HeightRequest="4" CornerRadius="2" Color="{StaticResource AccentEmerald}"
                     Opacity="{Binding Indicator2Opacity}" />
        </HorizontalStackLayout>

        <!-- STEP 0: Welcome + Prominent Manual City Selection -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10"
              IsVisible="{Binding IsStep0}">
            <VerticalStackLayout Spacing="4">
                <Label Text="Ezan Vakti'ne Hoş Geldiniz" Style="{StaticResource DisplayTitle}" FontSize="24" />
                <Label Text="Diyanet uyumlu namaz vakitleri ve kıble açısı için şehrinizi seçin. Dilerseniz GPS izni vermeden doğrudan listeden seçebilirsiniz."
                       Style="{StaticResource BodyMuted}" FontSize="13" LineHeight="1.35" />
            </VerticalStackLayout>

            <!-- Selected City Confirmation + Optional GPS Button -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Padding="12,8"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource HairLine}, Dark={StaticResource HairLineDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource CardSurfaceDark}}">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding HasLocation}" Value="True">
                            <Setter Property="Stroke" Value="#6010B981" />
                            <Setter Property="BackgroundColor" Value="#1810B981" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image Source="icon_pin.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" />
                        <Label Text="{Binding LocationSummary}" FontSize="14" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Button Grid.Column="1"
                        Text="GPS ile Bul"
                        Style="{StaticResource OutlineButton}"
                        Command="{Binding UseDeviceLocationCommand}"
                        IsEnabled="{Binding IsLocating, Converter={StaticResource InverseBool}}" />
            </Grid>

            <!-- Quick Popular Cities Chips -->
            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding PopularCities}" Spacing="6">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:TurkishCity">
                            <Border Style="{StaticResource InfoChip}" Padding="12,7">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OnboardingViewModel}}, Path=SelectCityCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Label Text="{Binding DisplayName}" FontSize="12" FontFamily="OpenSansSemibold" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Search Input & Error Notice -->
            <VerticalStackLayout Grid.Row="3" Spacing="6">
                <Label Text="{Binding LocationError}"
                       TextColor="{StaticResource Error}" FontSize="12"
                       IsVisible="{Binding LocationError, Converter={StaticResource StringNotEmpty}}" />
                <Border Style="{StaticResource PremiumInput}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image Source="icon_search.png" WidthRequest="15" HeightRequest="15" Opacity="0.65" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="81 il içinde şehir veya plaka ara..." Text="{Binding CitySearch}" ClearButtonVisibility="WhileEditing" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- 81 Cities List -->
            <CollectionView Grid.Row="4" ItemsSource="{Binding FilteredCities}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TurkishCity">
                        <Border Margin="0,3" Padding="14,11"
                                Style="{StaticResource GlassCardCompact}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OnboardingViewModel}}, Path=SelectCityCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Text="{Binding PlateLabel}" TextColor="{StaticResource AccentEmerald}"
                                       FontFamily="OpenSansSemibold" FontSize="13" VerticalOptions="Center" WidthRequest="32" />
                                <Label Grid.Column="1" Text="{Binding DisplayName}"
                                       FontSize="15" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="Seç ›" Style="{StaticResource BodyMuted}" FontSize="12" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- STEP 1: Theme + Contextual Notification Explanation -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsStep1}">
            <VerticalStackLayout Spacing="16" VerticalOptions="Center">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Görünüm ve Bildirimler" Style="{StaticResource DisplayTitle}" FontSize="24" />
                    <Label Text="Seçtiğiniz şehir: " Style="{StaticResource BodyMuted}" FontSize="13">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Seçili konum: " />
                                <Span Text="{Binding LocationSummary}" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentEmerald}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- Theme Card -->
                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="GÖRÜNÜM TEMASI" Style="{StaticResource SectionLabel}" />
                        <Border Style="{StaticResource PremiumInput}" Padding="10,0">
                            <Picker SelectedIndex="{Binding ThemeIndex}" Title="Tema seçin">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Sistem temasına uy</x:String>
                                        <x:String>Açık tema</x:String>
                                        <x:String>Koyu tema</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Contextual Notifications Card -->
                <Border Style="{StaticResource GlassCard}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="VAKİT BİLDİRİMLERİ" Style="{StaticResource SectionLabel}" />
                                <Label Text="Uygulama kapalıyken vakit girdiğinde haber ver" FontFamily="OpenSansSemibold" FontSize="15" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding NotificationsEnabled}" Style="{StaticResource PremiumSwitch}" />
                        </Grid>
                        <Label Text="Neden izin gerekiyor? Android, namaz vakti hatırlatmalarını ve bildirim çubuğundaki vakit göstergesini sunabilmek için bildirim izni ister. İzin vermeseniz bile tüm özellikleri kullanabilirsiniz."
                               Style="{StaticResource BodyMuted}" FontSize="12" LineHeight="1.4" />
                    </VerticalStackLayout>
                </Border>

                <!-- Privacy Guarantee -->
                <Border Style="{StaticResource GlassCardCompact}">
                    <Label Text="Gizlilik: Verileriniz yalnızca cihazınızda saklanır. Hesap, reklam veya takip kodu yoktur."
                           Style="{StaticResource BodyMuted}" FontSize="12" />
                </Border>

                <Button Text="İzin Vermeden Devam Et"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding FinishWithoutNotificationsCommand}"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Text="← Şehir Seçimi"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding IsNotFirstStep}" />

            <Button Grid.Column="1"
                    Text="{Binding NextButtonText}"
                    Style="{StaticResource PremiumButton}"
                    Command="{Binding NextCommand}"
                    IsEnabled="{Binding IsFinishing, Converter={StaticResource InverseBool}}" />
        </Grid>
    </Grid>
</ContentPage>
