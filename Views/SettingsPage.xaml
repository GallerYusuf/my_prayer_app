<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundDeep}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light=#EEF2FF, Dark={StaticResource BackgroundMid}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="20,16,20,32" Spacing="18">

                <Label Text="Ayarlar" Style="{StaticResource DisplayTitle}" FontSize="28" />

                <!-- KONUM -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="KONUM" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12" Padding="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Seçili konum" Style="{StaticResource BodyMuted}" FontSize="12" />
                                    <Label Text="{Binding LocationSummary}"
                                           FontFamily="OpenSansSemibold" FontSize="15"
                                           TextColor="{StaticResource AccentGold}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Şehir Seç"
                                        Style="{StaticResource OutlineButton}"
                                        Command="{Binding OpenCityPickerCommand}" />
                                <Button Grid.Column="1"
                                        Text="Konumumu Kullan"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding UseDeviceLocationCommand}"
                                        IsEnabled="{Binding IsLocating, Converter={StaticResource InverseBool}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- HESAPLAMA -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="NAMAZ VAKİTLERİ" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12" Padding="4">
                            <Label Text="Hesaplama yöntemi" Style="{StaticResource BodyMuted}" FontSize="12" />
                            <Picker ItemsSource="{Binding MethodOptions}"
                                    ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:CalculationMethodOption}"
                                    SelectedIndex="{Binding SelectedMethodIndex}"
                                    Title="Yöntem seçin" />
                            <BoxView Style="{StaticResource SettingsDivider}" />
                            <Label Text="Manuel dakika düzeltmeleri" Style="{StaticResource BodyMuted}" FontSize="12" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Adjustments}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AdjustmentItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Border Grid.Column="1" Style="{StaticResource IconButton}"
                                                    WidthRequest="36" HeightRequest="36"
                                                    SemanticProperties.Description="Bir dakika azalt">
                                                <Label Text="−" FontSize="18" TextColor="{StaticResource AccentGold}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding DecrementCommand}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <Label Grid.Column="2"
                                                   Text="{Binding Minutes, StringFormat='{0} dk'}"
                                                   FontFamily="OpenSansSemibold" FontSize="14"
                                                   WidthRequest="52"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{StaticResource AccentEmerald}" />
                                            <Border Grid.Column="3" Style="{StaticResource IconButton}"
                                                    WidthRequest="36" HeightRequest="36"
                                                    SemanticProperties.Description="Bir dakika artır">
                                                <Label Text="+" FontSize="18" TextColor="{StaticResource AccentGold}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding IncrementCommand}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- BİLDİRİMLER -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="BİLDİRİMLER" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="14" Padding="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Namaz vakti bildirimleri" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding PrayerNotificationsEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Güneş (doğuş) bildirimi" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding SunriseNotificationEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                            <BoxView Style="{StaticResource SettingsDivider}" />
                            <Label Text="Vakitten kaç dakika önce hatırlatılsın?" Style="{StaticResource BodyMuted}" FontSize="12" />
                            <HorizontalStackLayout Spacing="8">
                                <Border Style="{StaticResource InfoChip}" Padding="12,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="0" />
                                    </Border.GestureRecognizers>
                                    <Label Text="Kapalı" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                                <Border Style="{StaticResource InfoChip}" Padding="12,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="5" />
                                    </Border.GestureRecognizers>
                                    <Label Text="5 dk" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                                <Border Style="{StaticResource InfoChip}" Padding="12,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="10" />
                                    </Border.GestureRecognizers>
                                    <Label Text="10 dk" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                                <Border Style="{StaticResource InfoChip}" Padding="12,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="15" />
                                    </Border.GestureRecognizers>
                                    <Label Text="15 dk" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                                <Border Style="{StaticResource InfoChip}" Padding="12,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="30" />
                                    </Border.GestureRecognizers>
                                    <Label Text="30 dk" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="{Binding MinutesBeforePrayer, StringFormat='Seçili: {0} dk önce (0 = kapalı)'}"
                                   Style="{StaticResource BodyMuted}" FontSize="12" />
                            <BoxView Style="{StaticResource SettingsDivider}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Ses" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding SoundEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Titreşim" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding VibrationEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- AYET & CUMA -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="AYET VE CUMA BİLDİRİMLERİ" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="14" Padding="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Günün ayeti bildirimi" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding VerseNotificationsEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding VerseNotificationsEnabled}">
                                <Label Text="Ayet bildirim saati" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <TimePicker Grid.Column="1" Time="{Binding VerseTime}" />
                            </Grid>
                            <BoxView Style="{StaticResource SettingsDivider}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Cuma hatırlatıcısı" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding FridayNotificationsEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding FridayNotificationsEnabled}">
                                <Label Text="Cuma bildirimi saati" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <TimePicker Grid.Column="1" Time="{Binding FridayTime}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- GÖRÜNÜM -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="GÖRÜNÜM" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12" Padding="4">
                            <Label Text="Tema" Style="{StaticResource BodyMuted}" FontSize="12" />
                            <Picker ItemsSource="{Binding ThemeOptions}"
                                    SelectedIndex="{Binding ThemeIndex}"
                                    Title="Tema seçin" />
                            <BoxView Style="{StaticResource SettingsDivider}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Ramazan modu" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Switch Grid.Column="1" IsToggled="{Binding RamadanModeEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SAVE -->
                <Button Text="Kaydet"
                        Style="{StaticResource PremiumButton}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" />

                <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}"
                        StrokeThickness="1" Stroke="#5010B981" BackgroundColor="#2010B981"
                        StrokeShape="RoundRectangle 12" Padding="12,10">
                    <Label Text="{Binding StatusMessage}" TextColor="{StaticResource AccentEmerald}" FontSize="13" />
                </Border>

                <!-- TANILAMA -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="BİLDİRİM TANILAMA" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12" Padding="4">
                            <Label Text="{Binding DiagnosticsText}"
                                   FontSize="13"
                                   LineHeight="1.4"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Test Bildirimi"
                                        Style="{StaticResource OutlineButton}"
                                        Command="{Binding TestNotificationCommand}" />
                                <Button Grid.Column="1"
                                        Text="Bildirim Ayarları"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenNotificationSettingsCommand}" />
                            </Grid>
                            <Button Text="Tam Zamanlı Alarm İzni"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenExactAlarmSettingsCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- HAKKINDA -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="HAKKINDA" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="8" Padding="4">
                            <Label Text="{Binding AppVersion}" FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="Vakitler Aladhan API üzerinden Diyanet İşleri Başkanlığı yöntemiyle hesaplanır. Meal: Diyanet İşleri (quran-json). Veriler cihazınızda saklanır; hesap, analiz ve reklam yoktur."
                                   Style="{StaticResource BodyMuted}" FontSize="12" LineHeight="1.4" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
