<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Ayarlar"
             Shell.NavBarIsVisible="True">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Sticky Auto-Save Confirmation Banner -->
        <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}"
                Margin="16,8,16,0"
                StrokeThickness="1"
                Stroke="#6010B981"
                BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#122B23}"
                StrokeShape="RoundRectangle 12"
                Padding="14,10">
            <Label Text="{Binding StatusMessage}"
                   TextColor="{StaticResource AccentEmerald}"
                   FontFamily="OpenSansSemibold"
                   FontSize="13" />
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,32" Spacing="18">

                <!-- 1. KONUM -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="1. KONUM" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Image Source="icon_pin.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Aktif şehir / ilçe" Style="{StaticResource BodyMuted}" FontSize="12" />
                                    <Label Text="{Binding LocationSummary}"
                                           FontFamily="OpenSansSemibold" FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentGold}}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Şehir / İlçe Seç"
                                        Style="{StaticResource OutlineButton}"
                                        Command="{Binding OpenCityPickerCommand}" />
                                <Button Grid.Column="1"
                                        Text="GPS ile Bul"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding UseDeviceLocationCommand}"
                                        IsEnabled="{Binding IsLocating, Converter={StaticResource InverseBool}}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 2. VAKİTLER VE HESAPLAMA -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="2. VAKİT HESAPLAMA" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Hesaplama yöntemi" Style="{StaticResource BodyMuted}" FontSize="12" />
                                <Border Style="{StaticResource PremiumInput}" Padding="10,0">
                                    <Picker ItemsSource="{Binding MethodOptions}"
                                            ItemDisplayBinding="{Binding DisplayName, x:DataType=vm:CalculationMethodOption}"
                                            SelectedIndex="{Binding SelectedMethodIndex}"
                                            Title="Yöntem seçin" />
                                </Border>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource SettingsDivider}" />

                            <!-- Collapsible Manual Minute Adjustments -->
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Manuel dakika düzeltmeleri (Temkin)" FontSize="14" FontFamily="OpenSansSemibold" />
                                    <Label Text="Vakitlere ± dakika ekleyin veya çıkarın" Style="{StaticResource BodyMuted}" FontSize="11" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="Düzenle ▾"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding ToggleAdjustmentsCommand}" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Adjustments}"
                                                 Spacing="8"
                                                 IsVisible="{Binding IsAdjustmentsOpen}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AdjustmentItem">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                                            <Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center" />
                                            <Border Grid.Column="1" Style="{StaticResource IconButton}"
                                                    WidthRequest="36" HeightRequest="36"
                                                    SemanticProperties.Description="Bir dakika azalt">
                                                <Label Text="−" FontSize="18" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding DecrementCommand}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                            <Label Grid.Column="2"
                                                   Text="{Binding Minutes, StringFormat='{}{0} dk'}"
                                                   FontFamily="OpenSansSemibold" FontSize="14"
                                                   WidthRequest="52"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="{StaticResource AccentEmerald}" />
                                            <Border Grid.Column="3" Style="{StaticResource IconButton}"
                                                    WidthRequest="36" HeightRequest="36"
                                                    SemanticProperties.Description="Bir dakika artır">
                                                <Label Text="+" FontSize="18" FontFamily="OpenSansSemibold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding IncrementCommand}" />
                                                </Border.GestureRecognizers>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 3. BİLDİRİMLER -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="3. BİLDİRİMLER VE HATIRLATMALAR" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="Namaz vakti bildirimleri" FontSize="14" FontFamily="OpenSansSemibold" />
                                    <Label Text="Vakit girdiğinde bildirim gönderilir" Style="{StaticResource BodyMuted}" FontSize="11" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding PrayerNotificationsEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Güneş (doğuş) bildirimi" FontSize="14" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding SunriseNotificationEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="Sürekli vakit çubuğu (Android)" FontSize="14" FontFamily="OpenSansSemibold" />
                                    <Label Text="Günün vakitleri bildirim çubuğunda sessizce sabit durur" Style="{StaticResource BodyMuted}" FontSize="11" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding PersistentNotificationEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>

                            <BoxView Style="{StaticResource SettingsDivider}" />

                            <Label Text="Vakitten önce hatırlatma süresi" Style="{StaticResource BodyMuted}" FontSize="12" />
                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                                <Border Style="{StaticResource InfoChip}" Padding="6,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="0" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMin0}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#2010B981" />
                                            <Setter Property="Stroke" Value="#6010B981" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="Kapalı" FontSize="12" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource InfoChip}" Padding="6,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="5" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMin5}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#2010B981" />
                                            <Setter Property="Stroke" Value="#6010B981" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="5 dk" FontSize="12" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource InfoChip}" Padding="6,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="10" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMin10}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#2010B981" />
                                            <Setter Property="Stroke" Value="#6010B981" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="10 dk" FontSize="12" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource InfoChip}" Padding="6,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="15" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMin15}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#2010B981" />
                                            <Setter Property="Stroke" Value="#6010B981" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="15 dk" FontSize="12" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource InfoChip}" Padding="6,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="30" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMin30}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#2010B981" />
                                            <Setter Property="Stroke" Value="#6010B981" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="30 dk" FontSize="12" FontFamily="OpenSansSemibold" HorizontalOptions="Center" />
                                </Border>
                            </Grid>

                            <BoxView Style="{StaticResource SettingsDivider}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Bildirim sesi" FontSize="14" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding SoundEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Titreşim" FontSize="14" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding VibrationEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>

                            <BoxView Style="{StaticResource SettingsDivider}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Günün ayeti bildirimi" FontSize="14" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding VerseNotificationsEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding VerseNotificationsEnabled}">
                                <Label Text="Ayet bildirim saati" Style="{StaticResource BodyMuted}" FontSize="13" VerticalOptions="Center" />
                                <TimePicker Grid.Column="1" Time="{Binding VerseTime}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Cuma hatırlatıcısı" FontSize="14" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding FridayNotificationsEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding FridayNotificationsEnabled}">
                                <Label Text="Cuma bildirimi saati" Style="{StaticResource BodyMuted}" FontSize="13" VerticalOptions="Center" />
                                <TimePicker Grid.Column="1" Time="{Binding FridayTime}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 4. GÖRÜNÜM -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="4. GÖRÜNÜM" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Uygulama teması" Style="{StaticResource BodyMuted}" FontSize="12" />
                                <Border Style="{StaticResource PremiumInput}" Padding="10,0">
                                    <Picker ItemsSource="{Binding ThemeOptions}"
                                            SelectedIndex="{Binding ThemeIndex}"
                                            Title="Tema seçin" />
                                </Border>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource SettingsDivider}" />

                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="Ramazan modu" FontSize="14" FontFamily="OpenSansSemibold" />
                                    <Label Text="Ramazan ayında Bugün ekranında iftar/sahur sayacını öne çıkarır" Style="{StaticResource BodyMuted}" FontSize="11" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" IsToggled="{Binding RamadanModeEnabled}" Style="{StaticResource PremiumSwitch}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 5. VERİ VE YEDEKLEME -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="5. VERİ VE YEDEKLEME" Style="{StaticResource SectionLabel}" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Ayarlarınızı, favori ayetlerinizi, kaza çetelenizi ve hatim/zikir geçmişinizi cihazınıza yedekleyebilir veya geri yükleyebilirsiniz."
                                   Style="{StaticResource BodyMuted}" FontSize="12" LineHeight="1.4" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Yedek Dışa Aktar"
                                        Style="{StaticResource OutlineButton}"
                                        Command="{Binding BackupDataCommand}" />
                                <Button Grid.Column="1"
                                        Text="Yedek Geri Yükle"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding RestoreDataCommand}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 6. GELİŞMİŞ TANILAMA (Tucked behind expandable toggle) -->
                <Border Style="{StaticResource SettingsGroup}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="Gelişmiş Bildirim Tanılama" FontSize="14" FontFamily="OpenSansSemibold" />
                                <Label Text="İzin kontrolü, tam zamanlı alarm ve test bildirimi" Style="{StaticResource BodyMuted}" FontSize="11" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Aç / Kapat ▾"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ToggleDiagnosticsCommand}" />
                        </Grid>

                        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsDiagnosticsOpen}">
                            <BoxView Style="{StaticResource SettingsDivider}" />
                            <Label Text="{Binding DiagnosticsText}"
                                   FontSize="13"
                                   LineHeight="1.45" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Test Bildirimi Gönder"
                                        Style="{StaticResource OutlineButton}"
                                        Command="{Binding TestNotificationCommand}" />
                                <Button Grid.Column="1"
                                        Text="Sistem Bildirim İzni"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding OpenNotificationSettingsCommand}" />
                            </Grid>
                            <Button Text="Tam Zamanlı Alarm İznini Aç (Android)"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenExactAlarmSettingsCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Explicit Save & Replan Button -->
                <Button Text="Ayarları Kaydet ve Bildirimleri Güncelle"
                        Style="{StaticResource PremiumButton}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBool}}" />

                <!-- HAKKINDA -->
                <Border Style="{StaticResource SettingsGroup}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding AppVersion}" FontSize="13" FontFamily="OpenSansSemibold" />
                        <Label Text="Vakitler Aladhan API üzerinden Diyanet İşleri Başkanlığı yöntemiyle hesaplanır. Kur'an meali: Diyanet İşleri. Tüm verileriniz cihazınızda saklanır; hesap, takip ve reklam yoktur."
                               Style="{StaticResource BodyMuted}" FontSize="11" LineHeight="1.4" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
