<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        <conv:IntEqualsConverter x:Key="IntEquals" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{AppThemeBinding Light={StaticResource AppBackground}, Dark={StaticResource BackgroundDeep}}" Offset="0" />
                <GradientStop Color="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource BackgroundElevated}}" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,16,20,24" Spacing="20">

                <!-- Header -->
                <VerticalStackLayout Spacing="4" Margin="0,4,0,0">
                    <Label Text="Ayarlar"
                           Style="{StaticResource DisplayTitle}"
                           FontSize="28" />
                    <Label Text="Konum ve bildirim tercihleriniz"
                           Style="{StaticResource BodyMuted}"
                           FontSize="14" />
                </VerticalStackLayout>

                <!-- First launch -->
                <Border StrokeThickness="1"
                        Stroke="#40D4AF37"
                        BackgroundColor="#18D4AF37"
                        StrokeShape="RoundRectangle 16"
                        Padding="16,14"
                        IsVisible="{Binding IsFirstLaunch}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Hoş geldiniz"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               TextColor="{StaticResource AccentGold}" />
                        <Label Text="Önce şehrinizi seçin, ardından Kaydet'e dokunun."
                               Style="{StaticResource BodyMuted}"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Border>

                <!-- ── Konum ── -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Konum" Style="{StaticResource SectionLabel}" Margin="4,0,0,0" />

                    <Border Style="{StaticResource SettingsGroup}">
                        <Border Padding="14,12"
                                StrokeThickness="0"
                                BackgroundColor="Transparent">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="40"
                                        HeightRequest="40"
                                        StrokeThickness="0"
                                        BackgroundColor="#1A10B981"
                                        StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding SelectedPlateCode, StringFormat='{0:D2}'}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           TextColor="{StaticResource AccentEmerald}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding LocationSummary}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding CityRegion, StringFormat='{0} · Türkiye'}"
                                           Style="{StaticResource BodyMuted}"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="Değiştir"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13"
                                       TextColor="{StaticResource AccentGold}"
                                       VerticalOptions="Center" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenCityPickerCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Border>
                </VerticalStackLayout>

                <!-- Ramazan -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Ramazan" Style="{StaticResource SectionLabel}" Margin="4,0,0,0" />
                    <Border Style="{StaticResource SettingsGroup}">
                        <Grid Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Ramazan modu"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Ramazan ayında iftar ve sahur kartı"
                                       Style="{StaticResource BodyMuted}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1"
                                    Style="{StaticResource PremiumSwitch}"
                                    VerticalOptions="Center"
                                    IsToggled="{Binding RamadanModeEnabled}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Bildirimler ── -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Bildirimler" Style="{StaticResource SectionLabel}" Margin="4,0,0,0" />

                    <Border Style="{StaticResource SettingsGroup}">
                        <VerticalStackLayout Spacing="0">

                            <!-- Vakit bildirimleri -->
                            <Grid Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Namaz vakitleri"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="Her vakit için hatırlatma"
                                           Style="{StaticResource BodyMuted}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        Style="{StaticResource PremiumSwitch}"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding PrayerNotificationsEnabled}" />
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding PrayerNotificationsEnabled}"
                                                 Padding="14,0,14,14"
                                                 Spacing="12">
                                <BoxView Style="{StaticResource SettingsDivider}" Margin="0" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Text="Tam vakitte bildir"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Switch Grid.Column="1"
                                            Style="{StaticResource PremiumSwitch}"
                                            VerticalOptions="Center"
                                            IsToggled="{Binding NotifyAtPrayerTime}" />
                                </Grid>

                                <VerticalStackLayout Spacing="8"
                                                     IsVisible="{Binding NotifyAtPrayerTime, Converter={StaticResource InverseBool}}">
                                    <Label Text="Ezandan kaç dakika önce?"
                                           Style="{StaticResource BodyMuted}"
                                           FontSize="12" />
                                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                        <Border Grid.Column="0"
                                                StrokeThickness="1"
                                                Stroke="{StaticResource GlassStroke}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="0,10"
                                                HorizontalOptions="Fill">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="5" />
                                            </Border.GestureRecognizers>
                                            <Label Text="5 dk"
                                                   FontSize="13"
                                                   FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding MinutesBeforePrayer, Converter={StaticResource IntEquals}, ConverterParameter=5}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#2510B981" />
                                                    <Setter Property="Stroke" Value="#5010B981" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Border Grid.Column="1"
                                                StrokeThickness="1"
                                                Stroke="{StaticResource GlassStroke}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="0,10">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="10" />
                                            </Border.GestureRecognizers>
                                            <Label Text="10 dk"
                                                   FontSize="13"
                                                   FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding MinutesBeforePrayer, Converter={StaticResource IntEquals}, ConverterParameter=10}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#2510B981" />
                                                    <Setter Property="Stroke" Value="#5010B981" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Border Grid.Column="2"
                                                StrokeThickness="1"
                                                Stroke="{StaticResource GlassStroke}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="0,10">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="15" />
                                            </Border.GestureRecognizers>
                                            <Label Text="15 dk"
                                                   FontSize="13"
                                                   FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding MinutesBeforePrayer, Converter={StaticResource IntEquals}, ConverterParameter=15}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#2510B981" />
                                                    <Setter Property="Stroke" Value="#5010B981" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                        <Border Grid.Column="3"
                                                StrokeThickness="1"
                                                Stroke="{StaticResource GlassStroke}"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="0,10">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding SelectMinutesBeforeCommand}" CommandParameter="30" />
                                            </Border.GestureRecognizers>
                                            <Label Text="30 dk"
                                                   FontSize="13"
                                                   FontFamily="OpenSansSemibold"
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding MinutesBeforePrayer, Converter={StaticResource IntEquals}, ConverterParameter=30}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#2510B981" />
                                                    <Setter Property="Stroke" Value="#5010B981" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <BoxView Style="{StaticResource SettingsDivider}" />

                            <!-- Cuma -->
                            <Grid Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Cuma hatırlatıcısı"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="Cuma namazı öncesi"
                                           Style="{StaticResource BodyMuted}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        Style="{StaticResource PremiumSwitch}"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding FridayNotificationsEnabled}" />
                            </Grid>

                            <Grid Padding="14,0,14,14"
                                  ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding FridayNotificationsEnabled}">
                                <Label Text="Hatırlatma saati"
                                       FontSize="14"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                <TimePicker Grid.Column="1"
                                            Time="{Binding FridayNotificationTime, Mode=TwoWay}"
                                            Format="HH:mm"
                                            FontFamily="OpenSansSemibold"
                                            TextColor="{StaticResource AccentGold}"
                                            VerticalOptions="Center" />
                            </Grid>

                            <BoxView Style="{StaticResource SettingsDivider}" />

                            <!-- Ayet -->
                            <Grid Padding="14,12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="Günün ayeti"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="Gün içinde ilham verici ayetler"
                                           Style="{StaticResource BodyMuted}"
                                           FontSize="12" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        Style="{StaticResource PremiumSwitch}"
                                        VerticalOptions="Center"
                                        IsToggled="{Binding VerseNotificationsEnabled}" />
                            </Grid>

                            <VerticalStackLayout Padding="14,0,14,14"
                                                 Spacing="12"
                                                 IsVisible="{Binding VerseNotificationsEnabled}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Text="Günlük bildirim sayısı"
                                           FontSize="14"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                        <Border Style="{StaticResource IconButton}"
                                                WidthRequest="34"
                                                HeightRequest="34">
                                            <Label Text="−" FontSize="18" TextColor="{StaticResource AccentGold}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding DecrementVerseCountCommand}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                        <Label Text="{Binding VerseNotificationCount}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="20"
                                               TextColor="{StaticResource AccentGold}"
                                               WidthRequest="24"
                                               HorizontalTextAlignment="Center"
                                               VerticalOptions="Center" />
                                        <Border Style="{StaticResource IconButton}"
                                                WidthRequest="34"
                                                HeightRequest="34">
                                            <Label Text="+" FontSize="18" TextColor="{StaticResource AccentGold}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding IncrementVerseCountCommand}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>

                                <CollectionView ItemsSource="{Binding VerseTimes}"
                                                SelectionMode="None">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:VerseTimeItem">
                                            <Grid IsVisible="{Binding IsActive}"
                                                  Padding="0,3"
                                                  ColumnDefinitions="Auto,*"
                                                  ColumnSpacing="10">
                                                <Label Text="{Binding Index, StringFormat='{0}.'}"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextMutedDark}"
                                                       VerticalOptions="Center"
                                                       WidthRequest="20" />
                                                <TimePicker Grid.Column="1"
                                                            Time="{Binding Time, Mode=TwoWay}"
                                                            Format="HH:mm"
                                                            FontFamily="OpenSansSemibold"
                                                            FontSize="14"
                                                            TextColor="{StaticResource AccentGold}"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ── Sorun giderme (daraltılabilir) ── -->
                <Border Style="{StaticResource SettingsGroup}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="14,14" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAdvancedCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Bildirim sorunları"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Test ve izin ayarları"
                                       Style="{StaticResource BodyMuted}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="▼"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMutedDark}"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsAdvancedExpanded}" Value="True">
                                        <Setter Property="Rotation" Value="180" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout Padding="14,0,14,14"
                                             Spacing="10"
                                             IsVisible="{Binding IsAdvancedExpanded}">
                            <BoxView Style="{StaticResource SettingsDivider}" Margin="0,0,0,4" />

                            <Label Text="{Binding NotificationDiagnostics}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                            <Button Text="Test bildirimi gönder"
                                    Style="{StaticResource OutlineButton}"
                                    FontSize="13"
                                    Command="{Binding TestNotificationCommand}" />

                            <Button Text="Bildirim izinlerini aç"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="13"
                                    Command="{Binding OpenNotificationSettingsCommand}" />

                            <Button Text="Tam alarm iznini aç"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="13"
                                    Command="{Binding OpenExactAlarmSettingsCommand}" />

                            <Button Text="Pil optimizasyonunu kapat"
                                    Style="{StaticResource GhostButton}"
                                    FontSize="13"
                                    Command="{Binding OpenBatterySettingsCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ── Hakkında (daraltılabilir) ── -->
                <Border Style="{StaticResource SettingsGroup}" Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="14,14" ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAboutCommand}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Hakkında"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Text="Ezan Vakti · v1.0"
                                       Style="{StaticResource BodyMuted}"
                                       FontSize="12" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Text="▼"
                                   FontSize="10"
                                   TextColor="{StaticResource TextMutedDark}"
                                   VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsAboutExpanded}" Value="True">
                                        <Setter Property="Rotation" Value="180" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout Padding="14,0,14,14"
                                             Spacing="10"
                                             IsVisible="{Binding IsAboutExpanded}">
                            <BoxView Style="{StaticResource SettingsDivider}" Margin="0,0,0,4" />

                            <Label Text="Namaz vakitleri Aladhan API (Diyanet yöntemi) üzerinden alınır. Ayetler cihazınızdaki yerel veriden gösterilir."
                                   Style="{StaticResource BodyMuted}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />

                            <Label Text="Tüm tercihleriniz yalnızca cihazınızda saklanır. GPS veya hesap gerektirmez."
                                   Style="{StaticResource BodyMuted}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />

                            <Label Text="Android: Ana ekrana 'Ezan Vakti' widget'ı ekleyerek vakitleri görün."
                                   Style="{StaticResource BodyMuted}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky footer -->
        <Border Grid.Row="1"
                StrokeThickness="1"
                Stroke="{StaticResource GlassStroke}"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardSurface}, Dark={StaticResource BackgroundMid}}"
                Padding="20,14,20,20">
            <VerticalStackLayout Spacing="10">
                <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmptyConverter}}"
                        StrokeThickness="0"
                        BackgroundColor="#1410B981"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,10">
                    <Label Text="{Binding StatusMessage}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="{StaticResource AccentEmeraldSoft}" />
                </Border>

                <Button Text="Kaydet"
                        Style="{StaticResource PremiumButton}"
                        HeightRequest="52"
                        Command="{Binding SaveCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsFirstLaunch}" Value="True">
                            <Setter Property="Text" Value="Başla" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
