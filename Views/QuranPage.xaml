<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrayerApp.ViewModels"
             xmlns:contracts="clr-namespace:PrayerApp.Core.Contracts;assembly=PrayerApp.Core"
             xmlns:domain="clr-namespace:PrayerApp.Core.Domain;assembly=PrayerApp.Core"
             xmlns:conv="clr-namespace:PrayerApp.Converters"
             x:Class="PrayerApp.Views.QuranPage"
             x:DataType="vm:QuranViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,14,16,0" RowSpacing="10">

        <!-- 0. Header + Sort Toggle -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="2">
                <Label Text="Kur'an-ı Kerim" Style="{StaticResource DisplayTitle}" />
                <Label Text="Çevrimdışı Arapça metin ve Diyanet meali · 114 sure" Style="{StaticResource BodyMuted}" FontSize="12" />
            </VerticalStackLayout>

            <Border Grid.Column="1" Style="{StaticResource InfoChip}" Padding="10,6" VerticalOptions="Center"
                    IsVisible="{Binding IsSurahTabActive}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleSortOrderCommand}" />
                </Border.GestureRecognizers>
                <Label FontSize="12" FontFamily="OpenSansSemibold"
                       TextColor="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentGold}}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding SortByNuzul}" Value="True">
                            <Setter Property="Text" Value="Sıra: Nüzul ⇅" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding SortByNuzul}" Value="False">
                            <Setter Property="Text" Value="Sıra: Mushaf ⇅" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </Grid>

        <!-- 1. Compact Resume + Khatm Strip (Collapsible management so list isn't pushed down) -->
        <Border Grid.Row="1" Style="{StaticResource GlassCardCompact}" Padding="12,10">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <!-- Continue reading tap area -->
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ContinueReadingCommand}" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="KALDIĞIN YERDEN DEVAM ET" Style="{StaticResource SectionLabel}" FontSize="10" />
                        <Label Text="{Binding LastReadText}"
                               FontSize="14" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource AccentEmerald}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Oku ›"
                            Style="{StaticResource OutlineButton}"
                            Padding="12,6"
                            MinimumHeightRequest="36"
                            VerticalOptions="Center"
                            Command="{Binding ContinueReadingCommand}" />

                    <!-- Keep the hatim action on its own line on narrow phones. -->
                    <Button Grid.Row="1" Grid.ColumnSpan="2"
                            Text="{Binding KhatmProgressText}"
                            Style="{StaticResource SectionTabButton}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentEmeraldSoft}}"
                            HorizontalOptions="Fill"
                            Command="{Binding ToggleKhatmPanelCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding HasActiveKhatm}" Value="False">
                                <Setter Property="Text" Value="Hatim planı oluştur ▾" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <!-- Expandable Khatm Drawer -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsKhatmPanelOpen}">
                    <BoxView Style="{StaticResource SettingsDivider}" />

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding HasActiveKhatm}">
                        <ProgressBar Progress="{Binding KhatmProgress}" ProgressColor="{StaticResource AccentEmerald}" />
                        <Label Text="{Binding KhatmDailyText}" Style="{StaticResource BodyMuted}" FontSize="12" />

                        <Grid ColumnDefinitions="Auto,76,Auto,Auto,*" ColumnSpacing="8">
                            <Label Text="Sayfa:" Style="{StaticResource BodyMuted}" FontSize="12" VerticalOptions="Center" />
                            <Border Grid.Column="1" Style="{StaticResource PremiumInput}" Padding="8,2">
                                <Entry Text="{Binding KhatmPageText}" Keyboard="Numeric" MaxLength="3" FontSize="13" HorizontalTextAlignment="Center" />
                            </Border>
                            <Button Grid.Column="2" Text="Kaydet" Style="{StaticResource OutlineButton}" Padding="10,6" MinimumHeightRequest="36" Command="{Binding SaveKhatmPageCommand}" />
                            <Button Grid.Column="3" Text="Sayfayı Aç ›" Style="{StaticResource GhostButton}" Padding="8,6" MinimumHeightRequest="36" Command="{Binding OpenKhatmPageCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                    <Label Text="Yeni hatim hedef süresi seçin:" Style="{StaticResource BodyMuted}" FontSize="12" />
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                        <Button Text="30 gün" Style="{StaticResource OutlineButton}" Padding="6,8" MinimumHeightRequest="36" Command="{Binding StartKhatmCommand}" CommandParameter="30" />
                        <Button Grid.Column="1" Text="60 gün" Style="{StaticResource OutlineButton}" Padding="6,8" MinimumHeightRequest="36" Command="{Binding StartKhatmCommand}" CommandParameter="60" />
                        <Button Grid.Column="2" Text="90 gün" Style="{StaticResource OutlineButton}" Padding="6,8" MinimumHeightRequest="36" Command="{Binding StartKhatmCommand}" CommandParameter="90" />
                        <Button Grid.Column="3" Text="Serbest" Style="{StaticResource OutlineButton}" Padding="6,8" MinimumHeightRequest="36" Command="{Binding StartKhatmCommand}" CommandParameter="0" />
                    </Grid>
                </VerticalStackLayout>

                <Label Text="{Binding KhatmCompletedMessage}"
                       FontSize="12" FontFamily="OpenSansSemibold"
                       TextColor="{StaticResource AccentEmerald}"
                       IsVisible="{Binding KhatmCompletedMessage, Converter={StaticResource StringNotEmpty}}" />
            </VerticalStackLayout>
        </Border>

        <!-- Native, shared section tabs with full-height touch targets. -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border Style="{StaticResource GlassCardCompact}" Padding="4" StrokeShape="RoundRectangle 12">
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                    <Button Text="Sureler" Style="{StaticResource SectionTabButton}"
                            Command="{Binding ShowSurahListCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSurahTabActive}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentEmeraldSoft}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Cüzler" Style="{StaticResource SectionTabButton}"
                            Command="{Binding ToggleJuzListCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowJuzList}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentEmeraldSoft}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="Konular" Style="{StaticResource SectionTabButton}"
                            Command="{Binding ToggleTopicsCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowTopics}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentEmeraldSoft}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowTopicVerses}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentEmeraldSoft}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="3" Text="Favoriler" Style="{StaticResource SectionTabButton}"
                            Command="{Binding ToggleFavoritesViewCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowFavorites}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentEmeraldDeep}, Dark={StaticResource AccentEmeraldSoft}}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <!-- Unified Search Input -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Border Style="{StaticResource PremiumInput}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image Source="icon_search.png" WidthRequest="15" HeightRequest="15" Opacity="0.65" VerticalOptions="Center" />
                        <Entry Grid.Column="1"
                               Placeholder="Sure adı, sure numarası veya mealde kelime ara..."
                               Text="{Binding SearchText}"
                               ClearButtonVisibility="WhileEditing" />
                    </Grid>
                </Border>
                <Button Grid.Column="1"
                        Text="Mealde Ara"
                        Style="{StaticResource OutlineButton}"
                        Padding="10,0"
                        IsVisible="{Binding CanForceVerseSearch}"
                        Command="{Binding SearchInVersesCommand}" />
            </Grid>
        </VerticalStackLayout>

        <!-- 3. Active List Content -->
        <Grid Grid.Row="3">
            <!-- Surah list -->
            <CollectionView x:Name="SurahsView"
                            ItemsSource="{Binding Surahs}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:SurahInfo">
                        <Border Margin="0,3" Padding="14,11"
                                Style="{StaticResource GlassCardCompact}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QuranViewModel}}, Path=OpenSurahCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="36" HeightRequest="36"
                                        StrokeThickness="1" Stroke="#4010B981"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Number}"
                                           FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentEmerald}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding TranslatedName}"
                                           FontSize="15" FontFamily="OpenSansSemibold" />
                                    <Label Style="{StaticResource BodyMuted}" FontSize="11">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Name}" />
                                                <Span Text=" · İniş sırası: " />
                                                <Span Text="{Binding NuzulNumber}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="2"
                                       Text="{Binding VerseCount, StringFormat='{}{0} ayet ›'}"
                                       Style="{StaticResource BodyMuted}" FontSize="12"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Juz list -->
            <CollectionView x:Name="JuzView"
                            ItemsSource="{Binding JuzList}"
                            SelectionMode="None"
                            IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:JuzInfo">
                        <Border Margin="0,3" Padding="14,11"
                                Style="{StaticResource GlassCardCompact}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QuranViewModel}}, Path=OpenJuzCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="36" HeightRequest="36"
                                        StrokeThickness="1" Stroke="#4010B981"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                        StrokeShape="RoundRectangle 10"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Number}"
                                           FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentEmerald}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Number, StringFormat='{}{0}. Cüz'}"
                                           FontSize="15" FontFamily="OpenSansSemibold" />
                                    <Label FontSize="12" Style="{StaticResource BodyMuted}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding StartSurahName}" />
                                                <Span Text=" Suresi " />
                                                <Span Text="{Binding StartVerse, StringFormat='{}{0}. ayetten başlar'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" FontSize="12" Style="{StaticResource BodyMuted}" VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Sayfa " />
                                            <Span Text="{Binding StartPage}" />
                                            <Span Text="–" />
                                            <Span Text="{Binding EndPage}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Topics list -->
            <CollectionView x:Name="TopicsView"
                            ItemsSource="{Binding Topics}"
                            SelectionMode="None"
                            IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="domain:QuranTopic">
                        <Border Margin="0,3" Padding="14,12"
                                Style="{StaticResource GlassCardCompact}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QuranViewModel}}, Path=OpenTopicCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="36" HeightRequest="36"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardSurfaceAlt}, Dark={StaticResource CardSurfaceAltDark}}"
                                        VerticalOptions="Center">
                                    <Image Source="icon_dua.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1"
                                       Text="{Binding Name}"
                                       FontSize="15" FontFamily="OpenSansSemibold"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="›" FontSize="22"
                                       TextColor="{StaticResource AccentEmerald}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Topic Verses view -->
            <Grid x:Name="TopicVersesView" RowDefinitions="Auto,*" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,0,0,6">
                    <Button Text="← Konulara Dön" Style="{StaticResource GhostButton}" Command="{Binding ToggleTopicsCommand}" HorizontalOptions="Start" Padding="8,0" HeightRequest="34" />
                    <Label Grid.Column="1" Text="{Binding SelectedTopicName}" FontSize="15" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource AccentEmerald}" VerticalOptions="Center" />
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding TopicVerses}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="contracts:Verse">
                            <Border Margin="0,3" Padding="14,12"
                                    Style="{StaticResource GlassCardCompact}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QuranViewModel}}, Path=OpenVerseCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Text}" FontSize="14" LineHeight="1.4" />
                                    <Label Text="{Binding Reference}"
                                           FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentEmerald}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Search results / favorites -->
            <CollectionView x:Name="ResultsView"
                            SelectionMode="None"
                            IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:Verse">
                        <Border Margin="0,3" Padding="14,12"
                                Style="{StaticResource GlassCardCompact}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:QuranViewModel}}, Path=OpenVerseCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Text}" FontSize="14" LineHeight="1.4" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Reference}"
                                           FontSize="12" FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentEmerald}" />
                                    <Label Grid.Column="1" Text="Ayete Git ›" FontSize="11" Style="{StaticResource BodyMuted}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout VerticalOptions="Center" Spacing="8" Padding="24"
                                 IsVisible="{Binding EmptyMessage, Converter={StaticResource StringNotEmpty}}">
                <Label Text="{Binding EmptyMessage}"
                       Style="{StaticResource BodyMuted}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               VerticalOptions="Center" HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
